# Конфигурация внешнего монитора (промт 4.2). Скопируйте в scripts/monitor.env НА ТОЙ МАШИНЕ,
# С КОТОРОЙ ЗАПУСКАЕТСЯ МОНИТОР, — не на самом сервере: монитор на том же сервере не заметит,
# что сервер лёг.
MONITOR_BASE_URL=https://qr.menu
MONITOR_DEMO_SLUG=demo

# Токен /health/detailed — тот же, что HEALTH_TOKEN в .env приложения.
MONITOR_HEALTH_TOKEN=

# Бот, КОТОРЫМ шлются алерты, и чат, куда они приходят. Может быть отдельным ботом:
# если основной бот лежит вместе с сервисом, алерт через него не уйдёт.
MONITOR_BOT_TOKEN=
MONITOR_CHAT_ID=

# Токен ПРОВЕРЯЕМОГО бота сервиса. Если не задан, берётся MONITOR_BOT_TOKEN.
MONITOR_SERVICE_BOT_TOKEN=

# Где монитор хранит состояние между запусками (дедупликация алертов, время начала простоя).
MONITOR_STATE_DIR=/var/lib/qrmenu-monitor
