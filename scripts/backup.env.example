# Конфигурация бэкапов (промт 4.1). Скопируйте в scripts/backup.env НА СЕРВЕРЕ и заполните.
#
# Отдельный файл, а не .env приложения: эти скрипты запускает systemd от root, Node о них
# ничего не знает, и смешивать конфигурацию рантайма с конфигурацией обслуживания — верный
# способ однажды раздать приложению доступ, который ему не нужен.
#
# Права: chmod 600. Здесь пароль к базе и токен бота.

# --- Что бэкапим ------------------------------------------------------------------------------
# Строка подключения к БД. Та же, что DATABASE_URL приложения.
BACKUP_DATABASE_URL=postgres://qrmenu:пароль@localhost:5432/qrmenu

# Каталог с загруженными фото. По умолчанию public/uploads рядом со скриптами.
BACKUP_UPLOADS_DIR=/opt/qrmenu/public/uploads

# Куда складывать бэкапы локально. ОБЯЗАН быть на другом физическом диске, чем БД:
# бэкап на том же диске, что и база, бэкапом не является (прямая формулировка промта).
BACKUP_DIR=/var/backups/qrmenu

# --- Вторая копия (обязательна) ----------------------------------------------------------------
# Куда копировать бэкап после успешного создания. Формат rsync: user@host:/path или локальный
# путь на СМОНТИРОВАННОМ внешнем хранилище. Пусто — вторая копия не делается, и скрипт
# предупреждает об этом при каждом запуске: одна копия — это не бэкап.
BACKUP_OFFSITE_TARGET=

# Дополнительные аргументы rsync для второй копии (например ключ ssh).
BACKUP_OFFSITE_RSYNC_OPTS=-e "ssh -i /root/.ssh/backup_key -o StrictHostKeyChecking=yes"

# --- Хранение (промт: 7 ежедневных, 4 еженедельных, 6 ежемесячных) ------------------------------
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# --- Пороги и таймауты --------------------------------------------------------------------------
# Промт: pg_dump зависает — таймаут 30 минут и убийство процесса с алертом.
BACKUP_DUMP_TIMEOUT_SECONDS=1800

# Промт: меньше 20% свободного места — предупреждение, меньше 10% — критический алерт.
BACKUP_DISK_WARN_PERCENT=20
BACKUP_DISK_CRIT_PERCENT=10

# --- Уведомления --------------------------------------------------------------------------------
# Алерты идут НАПРЯМУЮ в Telegram Bot API, а не через очередь уведомлений приложения:
# бэкап обязан достучаться именно тогда, когда приложение или база лежат, а очереди нужны оба.
BACKUP_BOT_TOKEN=
BACKUP_CHAT_ID=

# --- Состояние ----------------------------------------------------------------------------------
# Файл состояния для /health/detailed. ДОЛЖЕН совпадать с BACKUP_STATE_FILE в .env приложения,
# иначе health-check будет честно сообщать «бэкапы не настроены», пока они идут.
BACKUP_STATE_FILE=/var/lib/qrmenu/backup-state.json

# Каталог служебного состояния скриптов (счётчик неудач подряд, дата последней проверки).
BACKUP_STATE_DIR=/var/lib/qrmenu/backup

# --- Команды PostgreSQL --------------------------------------------------------------------------
# На обычном сервере оставьте как есть. Переопределяются, если PostgreSQL живёт в контейнере
# или клиентские утилиты стоят не в PATH. Пример для docker compose:
#   BACKUP_PGDUMP="docker compose -f /opt/qrmenu/docker-compose.yml exec -T db pg_dump"
#   BACKUP_PSQL="docker compose -f /opt/qrmenu/docker-compose.yml exec -T db psql"
#   BACKUP_PGRESTORE="docker compose -f /opt/qrmenu/docker-compose.yml exec -T db pg_restore"
BACKUP_PGDUMP=pg_dump
BACKUP_PSQL=psql
BACKUP_PGRESTORE=pg_restore
