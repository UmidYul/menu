<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= venueName %> — <%= t('publicMenu.pageTitleSuffix') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <main class="public-menu">
    <header class="menu-header container">
      <div class="brand"><%- include('../partials/brand', { compact: true }) %></div>
      <div class="header-actions">
        <% if (phone || (wifiSsid && wifiPassword) || instagramUrl || telegramUrl) { %>
          <div class="venue-quick-links">
            <% if (phone) { %>
              <a class="header-icon-link" href="tel:<%= phone.replace(/[^+\d]/g, '') %>" aria-label="<%= t('publicMenu.phoneLabel') %>" title="<%= t('publicMenu.phoneLabel') %>">
                <%- include('../partials/icon', { name: 'phone', size: 16 }) %>
              </a>
            <% } %>
            <% if (wifiSsid && wifiPassword) { %>
              <details class="item-menu">
                <summary class="header-icon-link" aria-label="<%= t('publicMenu.wifiHeading') %>" title="<%= t('publicMenu.wifiHeading') %>">
                  <%- include('../partials/icon', { name: 'wifi', size: 16 }) %>
                </summary>
                <div class="item-menu-panel wifi-menu-panel">
                  <h4><%- include('../partials/icon', { name: 'wifi', size: 13 }) %> <%= t('publicMenu.wifiHeading') %></h4>
                  <div class="wifi-row"><span><%= wifiSsid %></span></div>
                  <div class="wifi-row wifi-password">
                    <span id="headerWifiPasswordValue"><%= wifiPassword %></span>
                    <button type="button" class="wifi-copy-btn btn btn-outline" data-target="headerWifiPasswordValue" data-note="headerWifiCopiedNote">
                      <%- include('../partials/icon', { name: 'copy', size: 13 }) %> <%= t('publicMenu.wifiCopyButton') %>
                    </button>
                  </div>
                  <span id="headerWifiCopiedNote" class="copied" style="display:none;">
                    <%- include('../partials/icon', { name: 'copy', size: 12 }) %> <%= t('publicMenu.wifiCopied') %>
                  </span>
                </div>
              </details>
            <% } %>
            <% if (instagramUrl) { %>
              <a class="header-icon-link" href="<%= instagramUrl %>" target="_blank" rel="noopener" aria-label="<%= t('publicMenu.instagramLabel') %>" title="<%= t('publicMenu.instagramLabel') %>">
                <%- include('../partials/icon', { name: 'instagram', size: 16 }) %>
              </a>
            <% } %>
            <% if (telegramUrl) { %>
              <a class="header-icon-link" href="<%= telegramUrl %>" target="_blank" rel="noopener" aria-label="<%= t('publicMenu.telegramLabel') %>" title="<%= t('publicMenu.telegramLabel') %>">
                <%- include('../partials/icon', { name: 'telegram', size: 16 }) %>
              </a>
            <% } %>
          </div>
        <% } %>
        <div class="lang">
          <a href="?lang=ru" class="<%= lang === 'ru' ? 'active' : '' %>">RU</a>
          <a href="?lang=uz" class="<%= lang === 'uz' ? 'active' : '' %>">UZ</a>
        </div>
        <button type="button" id="shareBtn" aria-label="<%= t('publicMenu.shareButton') %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
        </button>
      </div>
    </header>

    <div class="venue container">
      <div class="venue-logo"><%= venueName.charAt(0).toUpperCase() %></div>
      <h1><%= venueName %></h1>
      <div class="venue-meta">
        <% if (address) { %>
          <% if (address2gisUrl) { %>
            <a href="<%= address2gisUrl %>" target="_blank" rel="noopener"><span class="pin">●</span> <%= address %></a>
          <% } else { %>
            <span><span class="pin">●</span> <%= address %></span>
          <% } %>
        <% } %>
      </div>
      <span id="copiedNote" class="copied" style="display:none;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <%= t('publicMenu.shareCopied') %>
      </span>
    </div>

    <% if (categories.length === 0) { %>
      <p class="empty-note container"><%= t('publicMenu.empty') %></p>
    <% } else { %>
      <div class="menu-layout container">
        <aside class="menu-sidebar">
          <% categories.forEach((category) => { %>
            <a href="/menu/<%= venueSlug %>/<%= category.id %><%= lang !== undefined && lang ? '?lang=' + lang : '' %>" class="<%= category.id === activeCategoryId ? 'active' : '' %>">
              <%- include('../partials/icon', { name: 'utensils', size: 18 }) %>
              <span><%= category.name %></span>
            </a>
          <% }) %>
        </aside>
        <div class="menu-sections">
          <h1 class="menu-heading"><%= t('publicMenu.menuHeading') %></h1>
          <section class="menu-section">
            <div class="list-title">
              <h2><%= group.categoryName %></h2>
            </div>
            <% if (group.items.length === 0) { %>
              <p class="empty-note"><%= t('publicMenu.categoryEmpty') %></p>
            <% } else { %>
              <div class="menu-grid">
                <% group.items.forEach((item) => { %>
                  <article class="menu-card <%= item.isAvailable ? '' : 'unavailable' %> <%= item.hasReveal ? 'has-reveal' : '' %>">
                    <%- include('../partials/dish-content', { item, t }) %>
                  </article>
                <% }) %>
              </div>
            <% } %>
          </section>
        </div>
      </div>
    <% } %>

    <% if (mapEmbedUrl || (wifiSsid && wifiPassword)) { %>
      <section class="info-blocks container">
        <% if (mapEmbedUrl) { %>
          <div class="info-block map-block">
            <h3><%= t('publicMenu.mapHeading') %></h3>
            <iframe class="map-embed" src="<%= mapEmbedUrl %>" loading="lazy" title="<%= venueName %>"></iframe>
            <% if (address2gisUrl) { %>
              <a href="<%= address2gisUrl %>" target="_blank" rel="noopener" class="btn btn-outline" style="margin-top:14px;">
                <%- include('../partials/icon', { name: 'externallink', size: 15 }) %> <%= t('publicMenu.addressLinkLabel') %>
              </a>
            <% } %>
          </div>
        <% } %>
        <% if (wifiSsid && wifiPassword) { %>
          <div class="info-block wifi-block">
            <h3><%- include('../partials/icon', { name: 'wifi', size: 18 }) %> <%= t('publicMenu.wifiHeading') %></h3>
            <div class="wifi-row"><span><%= wifiSsid %></span></div>
            <div class="wifi-row wifi-password">
              <span id="wifiPasswordValue"><%= wifiPassword %></span>
              <button type="button" class="wifi-copy-btn btn btn-outline" data-target="wifiPasswordValue" data-note="wifiCopiedNote">
                <%- include('../partials/icon', { name: 'copy', size: 14 }) %> <%= t('publicMenu.wifiCopyButton') %>
              </button>
            </div>
            <span id="wifiCopiedNote" class="copied" style="display:none;">
              <%- include('../partials/icon', { name: 'copy', size: 13 }) %> <%= t('publicMenu.wifiCopied') %>
            </span>
          </div>
        <% } %>
      </section>
    <% } %>

    <footer class="menu-footer container">
      <div>
        <b><%= venueName %></b>
        <% if (phone) { %><span><a href="tel:<%= phone.replace(/[^+\d]/g, '') %>"><%= phone %></a></span><% } %>
      </div>
      <% if (address) { %>
        <div>
          <b><%= t('venueSettings.addressLabel') %></b>
          <span><%= address %></span>
        </div>
      <% } %>
      <% if (instagramUrl || telegramUrl) { %>
        <div>
          <b>Social</b>
          <div class="social-links">
            <% if (instagramUrl) { %><a href="<%= instagramUrl %>" target="_blank" rel="noopener">Instagram</a><% } %>
            <% if (telegramUrl) { %><a href="<%= telegramUrl %>" target="_blank" rel="noopener">Telegram</a><% } %>
          </div>
        </div>
      <% } %>
    </footer>

    <% if (showPoweredBy) { %>
      <a href="/" class="back-proto"><%= t('publicMenu.poweredBy', { serviceName }) %></a>
    <% } %>
  </main>

  <div id="cartBar" class="cart-bar" hidden>
    <button type="button" id="cartBarToggle" class="cart-bar-btn">
      <%- include('../partials/icon', { name: 'cart', size: 18 }) %>
      <span id="cartBarCount">0</span>
      <span class="cart-bar-total" id="cartBarTotal"></span>
    </button>
  </div>

  <dialog id="cart-modal" class="modal">
    <div class="modal-head">
      <h3><%= t('publicMenu.cartTitle') %></h3>
      <button type="button" class="modal-close" onclick="this.closest('dialog').close()">
        <%- include('../partials/icon', { name: 'x', size: 18 }) %>
      </button>
    </div>
    <div class="modal-body">
      <div id="cartPanelList"></div>
      <button type="button" id="cartClearBtn" class="btn btn-outline" style="width:100%; margin-top:14px;"><%= t('publicMenu.cartClear') %></button>
    </div>
  </dialog>

  <script>
    (function () {
      var btn = document.getElementById('shareBtn');
      var note = document.getElementById('copiedNote');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var url = window.location.href;
        var title = document.title;
        if (navigator.share) {
          navigator.share({ title: title, url: url }).catch(function () {});
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () {
            note.style.display = 'inline-flex';
            setTimeout(function () { note.style.display = 'none'; }, 2000);
          });
        }
      });
    })();
  </script>

  <script>
    // Общий обработчик для всех кнопок копирования wifi-пароля — их может быть несколько
    // (шапка + инфо-блок), каждая указывает на свою пару value/note через data-атрибуты.
    (function () {
      document.querySelectorAll('.wifi-copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var valueEl = document.getElementById(btn.dataset.target);
          var note = document.getElementById(btn.dataset.note);
          if (!valueEl || !navigator.clipboard || !navigator.clipboard.writeText) return;
          navigator.clipboard.writeText(valueEl.textContent).then(function () {
            if (!note) return;
            note.style.display = 'inline-flex';
            setTimeout(function () { note.style.display = 'none'; }, 2000);
          });
        });
      });
    })();
  </script>

  <script>
    // Корзина живёт в sessionStorage вместе с метаданными позиции (имя/цена/валюта), а не
    // только количеством — теперь каждая категория рендерится на отдельной странице, и на
    // открытой странице в DOM есть только позиции ТЕКУЩЕЙ категории. Если бы meta хранилась
    // только в DOM (как раньше, на одной большой странице), сумма корзины была бы неверной для
    // позиций, добавленных на других категориях/страницах.
    (function () {
      var STORAGE_KEY = 'cart:<%= venueSlug %>';
      var cart = {};

      function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str == null ? '' : String(str);
        return div.innerHTML;
      }

      function fmt(n) {
        return Math.round(n).toLocaleString('ru-RU');
      }

      function loadCart() {
        try {
          var raw = sessionStorage.getItem(STORAGE_KEY);
          cart = raw ? JSON.parse(raw) : {};
        } catch (e) {
          cart = {};
        }
      }

      function saveCart() {
        try {
          sessionStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
        } catch (e) {}
      }

      function totalCount() {
        return Object.keys(cart).reduce(function (sum, id) { return sum + cart[id].qty; }, 0);
      }

      function totalSum() {
        return Object.keys(cart).reduce(function (sum, id) { return sum + cart[id].price * cart[id].qty; }, 0);
      }

      function renderSteppers() {
        document.querySelectorAll('.cart-control[data-item-id]').forEach(function (el) {
          var entry = cart[el.dataset.itemId];
          var qty = entry ? entry.qty : 0;
          var valueEl = el.querySelector('.qty-value');
          if (valueEl) valueEl.textContent = qty;
          el.classList.toggle('has-qty', qty > 0);
        });
      }

      function renderBar() {
        var bar = document.getElementById('cartBar');
        var count = totalCount();
        if (count === 0) {
          bar.hidden = true;
          return;
        }
        bar.hidden = false;
        document.getElementById('cartBarCount').textContent = count;
        document.getElementById('cartBarTotal').textContent = fmt(totalSum());
      }

      function renderPanel() {
        var list = document.getElementById('cartPanelList');
        var ids = Object.keys(cart).filter(function (id) { return cart[id].qty > 0; });
        if (ids.length === 0) {
          list.innerHTML = '<p style="color:var(--muted); font-size:13px; margin:0;"><%= t('publicMenu.cartEmpty') %></p>';
          return;
        }
        list.innerHTML = ids.map(function (id) {
          var entry = cart[id];
          return '<div class="cart-line">' +
            '<span class="cart-line-name">' + escapeHtml(entry.name) + '</span>' +
            '<div class="qty-stepper has-qty" data-item-id="' + id + '">' +
              '<button type="button" class="qty-btn qty-minus" aria-label="−">−</button>' +
              '<span class="qty-value">' + entry.qty + '</span>' +
              '<button type="button" class="qty-btn qty-plus" aria-label="+">+</button>' +
            '</div>' +
            '<strong class="cart-line-total">' + fmt(entry.price * entry.qty) + ' ' + escapeHtml(entry.currency) + '</strong>' +
          '</div>';
        }).join('');
      }

      function render() {
        renderSteppers();
        renderBar();
        renderPanel();
      }

      function changeQty(id, delta, meta) {
        var existing = cart[id];
        var qty = Math.max(0, Math.min(99, (existing ? existing.qty : 0) + delta));
        if (qty === 0) {
          delete cart[id];
        } else {
          cart[id] = {
            qty: qty,
            name: meta ? meta.name : (existing ? existing.name : ''),
            price: meta ? meta.price : (existing ? existing.price : 0),
            currency: meta ? meta.currency : (existing ? existing.currency : ''),
          };
        }
        saveCart();
        render();
      }

      function readMeta(control) {
        return {
          name: control.dataset.itemName,
          price: parseFloat(control.dataset.itemPrice),
          currency: control.dataset.itemCurrency,
        };
      }

      document.addEventListener('click', function (e) {
        var addBtn = e.target.closest('.cart-add-btn');
        if (addBtn) {
          e.preventDefault();
          var addControl = addBtn.closest('[data-item-id]');
          if (addControl) changeQty(addControl.dataset.itemId, 1, readMeta(addControl));
          return;
        }
        var btn = e.target.closest('.qty-btn');
        if (!btn) return;
        e.preventDefault();
        var stepper = btn.closest('[data-item-id]');
        if (!stepper) return;
        var hasMeta = stepper.hasAttribute('data-item-name');
        changeQty(stepper.dataset.itemId, btn.classList.contains('qty-plus') ? 1 : -1, hasMeta ? readMeta(stepper) : null);
      });

      var barToggle = document.getElementById('cartBarToggle');
      if (barToggle) {
        barToggle.addEventListener('click', function () {
          var dialog = document.getElementById('cart-modal');
          if (dialog) dialog.showModal();
        });
      }

      var clearBtn = document.getElementById('cartClearBtn');
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          cart = {};
          saveCart();
          render();
        });
      }

      loadCart();
      render();
    })();
  </script>

  <script>
    (function () {
      var STORAGE_KEY = 'favorites:<%= venueSlug %>';
      var favorites = {};
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        favorites = raw ? JSON.parse(raw) : {};
      } catch (e) {
        favorites = {};
      }

      function applyState() {
        document.querySelectorAll('.favorite-btn[data-item-id]').forEach(function (btn) {
          btn.classList.toggle('active', !!favorites[btn.dataset.itemId]);
        });
      }

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.favorite-btn');
        if (!btn) return;
        e.preventDefault();
        var id = btn.dataset.itemId;
        if (favorites[id]) {
          delete favorites[id];
        } else {
          favorites[id] = true;
        }
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(favorites)); } catch (e) {}
        applyState();
      });

      applyState();
    })();
  </script>

  <script>
    (function () {
      document.addEventListener('click', function (e) {
        if (e.target.closest('.cart-control') || e.target.closest('.favorite-btn')) return;
        var card = e.target.closest('.menu-card.has-reveal');
        if (!card) return;
        card.classList.toggle('expanded');
      });
    })();
  </script>
</body>
</html>
