<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%# При заходе по ссылке на блюдо (?item=<id>) заголовок/описание/картинка — этой позиции,
      чтобы ссылка разворачивалась превью блюда в Telegram, а не общей карточкой заведения. %>
  <% const _title = locals.pageTitle || (venueName + ' — ' + t('publicMenu.pageTitleSuffix')); %>
  <title><%= _title %></title>
  <meta name="description" content="<%= metaDescription %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% hreflangLinks.forEach((alt) => { %>
    <link rel="alternate" hreflang="<%= alt.lang %>" href="<%= alt.href %>">
  <% }) %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= serviceName %>">
  <meta property="og:locale" content="<%= ogLocale %>">
  <meta property="og:title" content="<%= _title %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:url" content="<%= locals.ogUrl || canonicalUrl %>">
  <meta property="og:image" content="<%= ogImageUrl %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= _title %>">
  <meta name="twitter:description" content="<%= metaDescription %>">
  <meta name="twitter:image" content="<%= ogImageUrl %>">
  <%- include('../partials/head-assets') %>
  <%# Промт 2.5. Манифест свой на каждое заведение — гость ставит на домашний экран «Одессу MA»,
      а не «qr.menu». theme_color дублируется мета-тегом: манифест читают не все браузеры,
      а цвет системной строки хочется видеть и в обычной вкладке. Значение — тот же токен
      --primary, литералом (в манифесте и мета-теге переменные не работают). %>
  <link rel="manifest" href="/menu/<%= venueSlug %>/manifest.webmanifest">
  <meta name="theme-color" content="#c65d42">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="<%= venueName %>">
  <script type="application/ld+json"><%- toSafeJsonLd(restaurantJsonLd) %></script>
</head>
<body>
  <%# Промт 2.5: индикация — ненавязчивая ПОЛОСА, а не модалка, и её можно закрыть.
      Одна полоса на три сообщения (сохранённое меню / готово обновление / предложение
      установки): показывать их одновременно всё равно незачем, а три разных элемента
      в разметке разошлись бы по стилю. %>
  <div id="pwaBar" class="pwa-bar" hidden role="status" aria-live="polite">
    <span id="pwaBarText" class="pwa-bar-text"></span>
    <button type="button" id="pwaBarAction" class="pwa-bar-action" hidden></button>
    <button type="button" id="pwaBarClose" class="pwa-bar-close" aria-label="<%= t('pwa.closeAriaLabel') %>">
      <%- include('../partials/icon', { name: 'x', size: 16 }) %>
    </button>
  </div>
  <% if (isPreview) { %>
    <div class="preview-banner"><%= t('publicMenu.previewBanner') %></div>
  <% } %>
  <main class="public-menu">
    <header class="menu-header container">
      <div class="brand"><%- include('../partials/brand', { compact: true }) %></div>
      <div class="header-actions">
        <% if (phone || (wifiSsid && wifiPassword) || instagramUrl || telegramUrl) { %>
          <div class="venue-quick-links">
            <% if (phone) { %>
              <a class="header-icon-link" href="tel:<%= phone.replace(/[^+\d]/g, '') %>" aria-label="<%= t('publicMenu.phoneLabel') %>" title="<%= t('publicMenu.phoneLabel') %>">
                <%- include('../partials/icon', { name: 'phone', size: 16 }) %>
              </a>
            <% } %>
            <% if (wifiSsid && wifiPassword) { %>
              <button type="button" class="header-icon-link" aria-label="<%= t('publicMenu.wifiHeading') %>" title="<%= t('publicMenu.wifiHeading') %>" data-modal-open="wifi-modal">
                <%- include('../partials/icon', { name: 'wifi', size: 16 }) %>
              </button>
            <% } %>
            <% if (instagramUrl) { %>
              <a class="header-icon-link" href="<%= instagramUrl %>" target="_blank" rel="noopener" aria-label="<%= t('publicMenu.instagramLabel') %>" title="<%= t('publicMenu.instagramLabel') %>">
                <%- include('../partials/icon', { name: 'instagram', size: 16 }) %>
              </a>
            <% } %>
            <% if (telegramUrl) { %>
              <a class="header-icon-link" href="<%= telegramUrl %>" target="_blank" rel="noopener" aria-label="<%= t('publicMenu.telegramLabel') %>" title="<%= t('publicMenu.telegramLabel') %>">
                <%- include('../partials/icon', { name: 'telegram', size: 16 }) %>
              </a>
            <% } %>
          </div>
        <% } %>
        <% if (langSwitcherOptions.length > 1) { %>
        <div class="lang">
          <% langSwitcherOptions.forEach((opt) => { %>
            <a href="?lang=<%= opt.code %>" class="<%= lang === opt.code ? 'active' : '' %>"><%= opt.label %></a>
          <% }) %>
        </div>
        <% } %>
        <button type="button" id="shareBtn" data-share-button data-share-note="copiedNote" aria-label="<%= t('publicMenu.shareButton') %>">
          <%- include('../partials/icon', { name: 'share', size: 18 }) %>
        </button>
      </div>
    </header>

    <div class="venue-page container">
      <div class="venue-page-aside">
        <%- include('../partials/venue-card', {
          venueName, logoUrl, coverUrl, cuisine, categoryLabel, district, rating, reviewCount, ratingSource,
          description, address, address2gisUrl, workingHours, phone, email, t,
        }) %>
        <span id="copiedNote" class="copied" hidden>
          <%- include('../partials/icon', { name: 'check', size: 13 }) %>
          <%= t('publicMenu.shareCopied') %>
        </span>
      </div>

      <div class="venue-page-main">
        <%# «Меню пустое» и «меню сейчас закрыто по расписанию» — разные вещи, и путать их
            нельзя: первое означает, что заведение ещё не завело позиции, второе — что гость
            пришёл в неурочный час. В режиме hide на странице не остаётся ни одной секции,
            и без этой ветки гость увидел бы именно «пустое меню» (edge case промта 2.3). %>
        <% if (groups.length === 0 && otherTimeItems.length === 0 && allItemsOutOfSchedule) { %>
          <%- include('../partials/menu-closed-note', { nextOpeningTime, t }) %>
        <% } else if (groups.length === 0 && otherTimeItems.length === 0) { %>
          <p class="empty-note"><%= t('publicMenu.empty') %></p>
        <% } else { %>
          <div class="menu-toolbar">
            <div class="search-field">
              <span class="search-field-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'search', size: 17 }) %></span>
              <input type="search" id="menuSearchInput" class="search-field-input" placeholder="<%= t('publicMenu.searchPlaceholder') %>" aria-label="<%= t('publicMenu.searchPlaceholder') %>" autocomplete="off">
            </div>

            <details class="item-menu menu-toolbar-popover">
              <summary class="menu-toolbar-btn" aria-label="<%= t('publicMenu.sortAriaLabel') %>" title="<%= t('publicMenu.sortAriaLabel') %>">
                <%- include('../partials/icon', { name: 'arrowupdown', size: 17 }) %>
              </summary>
              <div class="item-menu-panel sort-panel" id="sortPanel">
                <h4><%= t('publicMenu.sortHeading') %></h4>
                <button type="button" class="sort-option active" data-sort-value="popularity">
                  <span class="sort-check"><%- include('../partials/icon', { name: 'check', size: 13 }) %></span>
                  <span><%= t('publicMenu.sortPopularity') %></span>
                </button>
                <button type="button" class="sort-option" data-sort-value="price-asc">
                  <span class="sort-check"><%- include('../partials/icon', { name: 'check', size: 13 }) %></span>
                  <span><%= t('publicMenu.sortPriceAsc') %></span>
                </button>
                <button type="button" class="sort-option" data-sort-value="price-desc">
                  <span class="sort-check"><%- include('../partials/icon', { name: 'check', size: 13 }) %></span>
                  <span><%= t('publicMenu.sortPriceDesc') %></span>
                </button>
                <button type="button" class="sort-option" data-sort-value="name">
                  <span class="sort-check"><%- include('../partials/icon', { name: 'check', size: 13 }) %></span>
                  <span><%= t('publicMenu.sortName') %></span>
                </button>
              </div>
            </details>

            <details class="item-menu menu-toolbar-popover">
              <summary class="menu-toolbar-btn" aria-label="<%= t('publicMenu.filterAriaLabel') %>" title="<%= t('publicMenu.filterAriaLabel') %>">
                <%- include('../partials/icon', { name: 'sliders', size: 17 }) %>
                <span class="toolbar-badge" id="filterBadge" hidden></span>
              </summary>
              <div class="item-menu-panel filter-panel" id="filterPanel">
                <h4><%= t('publicMenu.filterHeading') %></h4>
                <label class="filter-toggle-row">
                  <input type="checkbox" id="filterAvailableOnly">
                  <span><%= t('publicMenu.filterAvailableOnly') %></span>
                </label>
                <div class="filter-price-range">
                  <span class="filter-group-label"><%= t('publicMenu.filterPriceRange') %></span>
                  <div class="filter-price-inputs">
                    <input type="number" min="0" inputmode="numeric" id="filterPriceMin" placeholder="<%= t('publicMenu.filterPriceFrom') %>" aria-label="<%= t('publicMenu.filterPriceFrom') %>">
                    <input type="number" min="0" inputmode="numeric" id="filterPriceMax" placeholder="<%= t('publicMenu.filterPriceTo') %>" aria-label="<%= t('publicMenu.filterPriceTo') %>">
                  </div>
                </div>
                <% if (availableTags.length > 0) { %>
                  <div class="filter-tags">
                    <span class="filter-group-label"><%= t('publicMenu.filterTagsHeading') %></span>
                    <div class="checkbox-row">
                      <% availableTags.forEach((tag) => { %>
                        <label><input type="checkbox" class="filter-tag-checkbox" value="<%= tag.key %>"><span><%= tag.label %></span></label>
                      <% }) %>
                    </div>
                  </div>
                <% } %>
                <button type="button" class="btn btn-outline filter-reset-btn" id="filterResetBtn"><%= t('publicMenu.filterReset') %></button>
              </div>
            </details>
          </div>

          <nav class="category-nav" aria-label="<%= t('publicMenu.categoriesNavAriaLabel') %>" id="categoryNav">
            <button type="button" class="category-nav-arrow category-nav-arrow-left" data-scroll-dir="-1" aria-label="<%= t('publicMenu.scrollCategoriesLeft') %>" hidden>
              <%- include('../partials/icon', { name: 'chevronleft', size: 16 }) %>
            </button>
            <div class="category-nav-track" id="categoryNavTrack">
              <button type="button" class="category-chip active" data-category-chip="all"><%= t('publicMenu.allCategoriesLabel') %></button>
              <% groups.forEach((group) => { %>
                <%# Промт 2.3: недоступная сейчас категория приглушена. В режимах hide/section
                    её здесь уже нет — она отфильтрована на сервере (applyScheduleVisibility). %>
                <button type="button" class="category-chip <%= group.availableNow ? '' : 'chip-out-of-schedule' %>" data-category-chip="category-<%= group.categoryId %>" data-category-id="<%= group.categoryId %>"><%= group.categoryName %></button>
              <% }) %>
            </div>
            <button type="button" class="category-nav-arrow category-nav-arrow-right" data-scroll-dir="1" aria-label="<%= t('publicMenu.scrollCategoriesRight') %>" hidden>
              <%- include('../partials/icon', { name: 'chevronright', size: 16 }) %>
            </button>
          </nav>

          <p class="empty-note" id="searchEmptyNote" hidden><%= t('publicMenu.searchEmpty') %></p>

          <%# Режимы dim и section: секции на странице есть, сообщение идёт над ними. %>
          <% if (allItemsOutOfSchedule) { %>
            <%- include('../partials/menu-closed-note', { nextOpeningTime, t }) %>
          <% } %>

          <div class="menu-sections" id="menuSections">
            <% groups.forEach((group, groupIndex) => { %>
              <section class="menu-section <%= group.availableNow ? '' : 'section-out-of-schedule' %>" id="category-<%= group.categoryId %>" aria-labelledby="category-heading-<%= group.categoryId %>" data-category-section>
                <h2 class="menu-section-heading" id="category-heading-<%= group.categoryId %>"><%= group.categoryName %></h2>
                <%# Мелкая подпись с часами в шапке категории с расписанием (промт 2.3, п.3). %>
                <% if (group.scheduleLabel) { %>
                  <p class="menu-section-schedule"><%= group.scheduleLabel %></p>
                <% } %>
                <div class="dish-list">
                  <% group.items.forEach((item, itemIndex) => { %>
                    <%- include('../partials/dish-row', {
                      item, t, categoryName: group.categoryName,
                      reveal: groupIndex > 0,
                      revealDelay: Math.min(itemIndex * 40, 400),
                    }) %>
                  <% }) %>
                </div>
              </section>
            <% }) %>

            <%# Режим 'section': всё недоступное по времени — одной секцией внизу. Она вне
                data-category-section, поэтому не попадает в scroll-spy и чипсы. %>
            <% if (otherTimeItems.length > 0) { %>
              <section class="menu-section menu-section-other-time" id="other-time-section" aria-labelledby="other-time-heading">
                <h2 class="menu-section-heading" id="other-time-heading"><%= otherTimeHeading %></h2>
                <div class="dish-list">
                  <% otherTimeItems.forEach((item) => { %>
                    <%- include('../partials/dish-row', { item, t, categoryName: item.categoryName, reveal: false, revealDelay: 0 }) %>
                  <% }) %>
                </div>
              </section>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>

    <footer class="menu-footer container">
      <div>
        <b><%= t('publicMenu.footerContactsHeading') %></b>
        <span><%= venueName %></span>
        <% if (phone) { %><span><a href="tel:<%= phone.replace(/[^+\d]/g, '') %>"><%= phone %></a></span><% } %>
        <% if (address) { %><span><%= address %></span><% } %>
      </div>
      <% if (workingHours) { %>
        <div>
          <b><%= t('publicMenu.footerHoursHeading') %></b>
          <span class="working-hours"><%= workingHours %></span>
        </div>
      <% } %>
      <% if (instagramUrl || telegramUrl) { %>
        <div>
          <b><%= t('publicMenu.footerSocialHeading') %></b>
          <div class="social-links">
            <% if (instagramUrl) { %>
              <a class="footer-social-link" href="<%= instagramUrl %>" target="_blank" rel="noopener" aria-label="<%= t('publicMenu.instagramLabel') %>" title="<%= t('publicMenu.instagramLabel') %>">
                <%- include('../partials/icon', { name: 'instagram', size: 17 }) %>
              </a>
            <% } %>
            <% if (telegramUrl) { %>
              <a class="footer-social-link" href="<%= telegramUrl %>" target="_blank" rel="noopener" aria-label="<%= t('publicMenu.telegramLabel') %>" title="<%= t('publicMenu.telegramLabel') %>">
                <%- include('../partials/icon', { name: 'telegram', size: 17 }) %>
              </a>
            <% } %>
          </div>
        </div>
      <% } %>
    </footer>

    <%# Промт 3.2: короткая, ненавязчивая строка о сборе обезличенной статистики — не баннер
        согласия (собираем данные не о личности гостя, а IP/UA хешируются посуточно, см. README),
        но гость должен иметь возможность узнать об этом, не читая политику конфиденциальности. %>
    <p class="menu-analytics-note container"><%= t('publicMenu.analyticsDisclosure') %></p>

    <% if (showPoweredBy) { %>
      <div class="mini-footer container">
        <a href="/" class="brand mini-footer-brand"><%- include('../partials/brand', { compact: true }) %></a>
        <span class="mini-footer-tagline"><%= t('publicMenu.miniFooterTagline') %></span>
        <a href="/" class="btn btn-primary mini-footer-cta"><%= t('publicMenu.miniFooterCta') %></a>
      </div>
    <% } %>
  </main>

  <div id="cartBar" class="cart-bar" hidden>
    <button type="button" id="cartBarToggle" class="cart-bar-btn" aria-label="<%= t('publicMenu.cartBarAriaLabel') %>">
      <span class="cart-bar-icon">
        <%- include('../partials/icon', { name: 'cart', size: 18 }) %>
        <span id="cartBarCount" class="cart-bar-badge">0</span>
      </span>
      <span id="cartBarItemsLabel" class="cart-bar-items-label"></span>
      <span class="cart-bar-total" id="cartBarTotal"></span>
    </button>
  </div>

  <% if (reviewsAvailable) { %>
    <%# Промт 3.3. Приглашение к отзыву. В HTML попадает только «сбор включён у заведения» —
        показывать ли карточку ИМЕННО этому гостю (не оставлял ли он отзыв в последние 30 дней)
        решает review-flow.js после ответа /review/:slug/context, потому что страница кэшируется
        по slug+lang. Звёзды — нативные radio: работают с клавиатуры и читаются скринридером,
        а базовый выбор оценки не требует JS вообще. %>
    <aside id="reviewPrompt" class="review-prompt" hidden>
      <button type="button" id="reviewPromptDismiss" class="review-prompt-dismiss" aria-label="<%= t('reviews.dismissAriaLabel') %>">
        <%- include('../partials/icon', { name: 'x', size: 16 }) %>
      </button>
      <p class="review-prompt-title"><%= t('reviews.promptTitle') %></p>
      <fieldset class="review-stars" id="reviewPromptStars">
        <legend class="sr-only"><%= t('reviews.ratingLegend') %></legend>
        <%# Звёзды идут в разметке от 5 к 1, а flex-direction: row-reverse возвращает их на
            экране в привычный порядок 1..5. Это единственный способ подсветить «все звёзды до
            выбранной» чистым CSS: селектор ~ умеет смотреть только вперёд по разметке.
            Плата — стрелки клавиатуры внутри группы идут справа налево; подпись каждой звезды
            («3 из 5») читается скринридером явно, так что смысл выбора от этого не теряется. %>
        <% for (let star = 5; star >= 1; star--) { %>
          <input type="radio" class="review-star-input" name="reviewRating" id="reviewStar<%= star %>" value="<%= star %>">
          <label class="review-star-label" for="reviewStar<%= star %>" title="<%= t('reviews.starAriaLabel', { star }) %>">
            <%- include('../partials/icon', { name: 'star', size: 30 }) %>
            <span class="sr-only"><%= t('reviews.starAriaLabel', { star }) %></span>
          </label>
        <% } %>
      </fieldset>
    </aside>

    <dialog id="review-modal" class="modal modal-sheet">
      <div class="modal-head">
        <h3 id="reviewModalTitle"><%= t('reviews.modalTitle') %></h3>
        <button type="button" class="modal-close" data-modal-close>
          <%- include('../partials/icon', { name: 'x', size: 18 }) %>
        </button>
      </div>
      <%# is-high / is-low переставляют местами блок карт и блок «для владельца» (см. CSS,
          свойство order) — разметка одна, чтобы обе ветки гарантированно жили в одном коде
          и кнопки публичного отзыва невозможно было случайно спрятать в одной из них. %>
      <div class="modal-body review-body" id="reviewBody">
        <div id="reviewError" class="alert alert-error" hidden></div>

        <div class="review-chosen" id="reviewChosen">
          <span class="review-chosen-stars" id="reviewChosenStars" aria-hidden="true"></span>
          <button type="button" class="review-change-btn" id="reviewChangeBtn"><%= t('reviews.changeRating') %></button>
        </div>

        <div class="review-owner-block" id="reviewOwnerBlock">
          <label class="review-field">
            <span class="review-field-label" id="reviewCommentLabel"></span>
            <textarea id="reviewComment" rows="3" maxlength="2000"></textarea>
          </label>
          <label class="review-field">
            <span class="review-field-label"><%= t('reviews.contactLabel') %></span>
            <input type="text" id="reviewContact" maxlength="120" placeholder="<%= t('reviews.contactPlaceholder') %>">
          </label>
          <p class="review-privacy-note"><%= t('reviews.privacyNote') %></p>
          <button type="button" id="reviewSubmitBtn" class="btn btn-primary review-submit"><%= t('reviews.submitButton') %></button>
          <p class="review-thanks" id="reviewThanks" hidden></p>
        </div>

        <%# Кнопки публичного отзыва видны в обеих ветках. В ветке низкой оценки они ниже и
            спокойнее по акценту, но не спрятаны и не заблокированы: прятать их неэтично и
            прямо запрещено правилами Google и Яндекса. %>
        <div class="review-maps" id="reviewMaps" hidden>
          <p class="review-maps-hint" id="reviewMapsHint"></p>
          <a id="reviewGoogleLink" class="btn review-map-btn" href="#" target="_blank" rel="noopener" hidden>
            <%- include('../partials/icon', { name: 'externallink', size: 16 }) %>
            <%= t('reviews.googleButton') %>
          </a>
          <a id="reviewYandexLink" class="btn review-map-btn" href="#" target="_blank" rel="noopener" hidden>
            <%- include('../partials/icon', { name: 'externallink', size: 16 }) %>
            <%= t('reviews.yandexButton') %>
          </a>
        </div>
      </div>
    </dialog>
  <% } %>

  <dialog id="cart-modal" class="modal">
    <div class="modal-head">
      <h3><%= t('publicMenu.cartTitle') %></h3>
      <button type="button" class="modal-close" data-modal-close>
        <%- include('../partials/icon', { name: 'x', size: 18 }) %>
      </button>
    </div>
    <div class="modal-body">
      <p id="cartChangedNote" class="cart-changed-note" hidden><%= t('publicMenu.cartChangedNote') %></p>
      <div id="cartPanelList"></div>
      <%# Промт 2.4: кнопка есть, только если заведение принимает заказы (признак уровня
          заведения, безопасно кэшируется вместе со страницей). Стол и часы работы проверяются
          отдельно — при открытии экрана подтверждения и ещё раз на сервере при отправке. %>
      <% if (ordersAvailable) { %>
        <button type="button" id="orderStartBtn" class="btn btn-primary order-start-btn">
          <%- include('../partials/icon', { name: 'cart', size: 16 }) %>
          <%= t('orders.sendOrderButton') %>
        </button>
      <% } %>
      <button type="button" id="cartClearBtn" class="btn btn-outline cart-clear-btn"><%= t('publicMenu.cartClear') %></button>
    </div>
  </dialog>

  <%# Одна общая модалка выбора опций на всё меню — содержимое рисует menu-cart.js по данным
      из #menuData; отдельный <dialog> на каждую позицию раздул бы страницу впустую. %>
  <dialog id="item-options-modal" class="modal modal-sheet">
    <div class="modal-head">
      <h3 id="optionsModalTitle"></h3>
      <button type="button" class="modal-close" data-modal-close>
        <%- include('../partials/icon', { name: 'x', size: 18 }) %>
      </button>
    </div>
    <div class="modal-body">
      <div id="optionsModalMedia" class="options-modal-media" hidden></div>
      <p id="optionsModalDescription" class="options-modal-description" hidden></p>
      <div id="optionsModalGroups"></div>
    </div>
    <div class="modal-foot">
      <button type="button" id="optionsSubmitBtn" class="btn btn-primary options-submit">
        <span class="options-submit-label"></span>
        <span class="options-submit-total"></span>
      </button>
    </div>
  </dialog>

  <% if (ordersAvailable) { %>
    <%# Заказ и вызов официанта (промт 2.4). Всё содержимое, зависящее от стола, наполняет
        order-flow.js после запроса /order/:slug/context — в кэшируемый HTML стол не попадает. %>
    <dialog id="order-modal" class="modal modal-sheet">
      <div class="modal-head">
        <h3 id="orderModalTitle"><%= t('orders.confirmHeading') %></h3>
        <button type="button" class="modal-close" data-modal-close>
          <%- include('../partials/icon', { name: 'x', size: 18 }) %>
        </button>
      </div>
      <div class="modal-body">
        <div id="orderError" class="alert alert-error" hidden></div>

        <div id="orderConfirmStep">
          <div id="orderLines" class="order-lines"></div>
          <div class="order-total-row">
            <span><%= t('orders.totalLabel') %></span>
            <strong id="orderTotal"></strong>
          </div>

          <div class="order-field" id="orderTableKnown" hidden>
            <span class="order-field-label"><%= t('orders.tableLabel') %></span>
            <b id="orderTableNumber"></b>
          </div>
          <label class="order-field" id="orderTableInput" hidden>
            <span class="order-field-label"><%= t('orders.tableManualLabel') %></span>
            <input type="text" id="orderTableNumberInput" maxlength="40" placeholder="<%= t('orders.tableManualPlaceholder') %>">
          </label>

          <label class="order-field">
            <span class="order-field-label"><%= t('orders.commentLabel') %></span>
            <textarea id="orderComment" rows="2" maxlength="500" placeholder="<%= t('orders.commentPlaceholder') %>"></textarea>
          </label>
        </div>

        <%# Экран «заказ отправлен»: номер крупно — промт просит предложить сделать скриншот,
            потому что вкладку могут закрыть и статус будет негде посмотреть. %>
        <div id="orderSentStep" hidden>
          <div class="order-sent">
            <span class="order-sent-label"><%= t('orders.sentOrderNumberLabel') %></span>
            <b id="orderSentNumber"></b>
            <p class="order-sent-hint"><%= t('orders.sentScreenshotHint') %></p>
            <div class="order-status-row">
              <span class="order-status-dot" id="orderStatusDot"></span>
              <span id="orderStatusText"></span>
            </div>
            <p class="order-undelivered" id="orderUndelivered" hidden><%= t('orders.undeliveredHint') %></p>
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button type="button" id="orderSubmitBtn" class="btn btn-primary options-submit">
          <span><%= t('orders.confirmButton') %></span>
        </button>
        <button type="button" id="orderCloseBtn" class="btn btn-outline options-submit" hidden><%= t('orders.closeButton') %></button>
      </div>
    </dialog>

    <dialog id="waiter-modal" class="modal modal-sheet">
      <div class="modal-head">
        <h3><%= t('orders.waiterHeading') %></h3>
        <button type="button" class="modal-close" data-modal-close>
          <%- include('../partials/icon', { name: 'x', size: 18 }) %>
        </button>
      </div>
      <div class="modal-body">
        <div id="waiterError" class="alert alert-error" hidden></div>
        <div id="waiterResult" class="alert alert-success" hidden></div>
        <div class="waiter-options" id="waiterOptions">
          <button type="button" class="waiter-option" data-call-type="come"><%= t('orders.waiterCome') %></button>
          <button type="button" class="waiter-option" data-call-type="bill"><%= t('orders.waiterBill') %></button>
          <button type="button" class="waiter-option" data-call-type="cutlery"><%= t('orders.waiterCutlery') %></button>
        </div>
      </div>
    </dialog>

    <%# Кнопка вызова официанта появляется только когда стол известен — это решает order-flow.js
        по ответу /context, поэтому в разметке она изначально скрыта. %>
    <button type="button" id="waiterCallBtn" class="waiter-call-btn" hidden aria-label="<%= t('orders.waiterHeading') %>">
      <%- include('../partials/icon', { name: 'bell', size: 20 }) %>
    </button>
  <% } %>

  <%# Карточка блюда (промт 2.2). Как и модалка опций — одна на всё меню: шапка с фото и кнопками
      статична (иконки из icon.ejs, подписи через t), а тело и подвал рисует dish-card.js. %>
  <dialog id="dish-card-modal" class="modal modal-sheet dish-card">
    <div class="dish-card-media" id="dishCardMedia">
      <div class="dish-card-photo" id="dishCardPhoto"></div>
      <div class="dish-card-media-actions">
        <button type="button" class="dish-card-action" id="dishCardShare" aria-label="<%= t('publicMenu.shareButton') %>" title="<%= t('publicMenu.shareButton') %>">
          <%- include('../partials/icon', { name: 'share', size: 17 }) %>
        </button>
        <button type="button" class="dish-card-action" id="dishCardClose" aria-label="<%= t('publicMenu.cardCloseAriaLabel') %>" title="<%= t('publicMenu.cardCloseAriaLabel') %>">
          <%- include('../partials/icon', { name: 'x', size: 18 }) %>
        </button>
      </div>
      <span class="dish-card-copied" id="dishCardCopied" hidden>
        <%- include('../partials/icon', { name: 'check', size: 13 }) %> <%= t('publicMenu.shareCopied') %>
      </span>
    </div>
    <div class="modal-body dish-card-body" id="dishCardBody"></div>
    <div class="modal-foot dish-card-foot" id="dishCardFoot" hidden>
      <button type="button" id="dishCardSubmit" class="btn btn-primary options-submit">
        <span class="options-submit-label"><%= t('publicMenu.optionAddToCart') %></span>
        <span class="options-submit-total"></span>
      </button>
    </div>
  </dialog>

  <% if (wifiSsid && wifiPassword) { %>
    <dialog id="wifi-modal" class="modal wifi-modal">
      <div class="modal-head">
        <h3><%- include('../partials/icon', { name: 'wifi', size: 18 }) %> <%= t('publicMenu.wifiHeading') %></h3>
        <button type="button" class="modal-close" data-modal-close>
          <%- include('../partials/icon', { name: 'x', size: 18 }) %>
        </button>
      </div>
      <div class="modal-body">
        <div class="wifi-field">
          <span class="wifi-field-label"><%= t('venueSettings.wifiSsidLabel') %></span>
          <div class="wifi-field-value"><span><%= wifiSsid %></span></div>
        </div>
        <div class="wifi-field">
          <span class="wifi-field-label"><%= t('venueSettings.wifiPasswordLabel') %></span>
          <div class="wifi-field-value wifi-field-value-password">
            <span id="wifiPasswordValue"><%= wifiPassword %></span>
            <button type="button" class="wifi-copy-btn" data-copy-target="wifiPasswordValue" data-copy-note="wifiCopiedNote" aria-label="<%= t('publicMenu.wifiCopyButton') %>" title="<%= t('publicMenu.wifiCopyButton') %>">
              <%- include('../partials/icon', { name: 'copy', size: 15 }) %>
            </button>
          </div>
        </div>
        <span id="wifiCopiedNote" class="copied wifi-copied-note" style="display:none;">
          <%- include('../partials/icon', { name: 'check', size: 13 }) %> <%= t('publicMenu.wifiCopied') %>
        </span>
      </div>
    </dialog>
  <% } %>

  <%# event-tracker.js — раньше public-menu.js (промт 3.2): оба defer, значит выполняются в
      порядке тегов независимо от того, кто раньше догрузился по сети; public-menu.js и другие
      файлы ниже читают window.eventTracker при первичной настройке обработчиков (не только по
      клику), так что он должен существовать уже на этот момент. defer-скрипт не начинает
      выполняться раньше полного разбора DOM, так что #menuData (он ниже по файлу) к этому
      моменту уже гарантированно есть — порядок тегов в файле на это не влияет. %>
  <script src="/js/event-tracker.js" defer></script>
  <script src="/js/public-menu.js" defer></script>

  <%#
    Данные меню для клиентской корзины и модалки опций (промт 2.1). JSON, а не набор
    data-атрибутов на строках: модалке нужны группы/варианты целиком, а корзине — ещё и
    возможность пересчитать строку, позиция которой сейчас скрыта фильтром или вообще
    не видна на экране. Тексты интерфейса кладём сюда же, чтобы menu-cart.js остался
    файлом без единой зашитой строки и без серверных шаблонных тегов.
  %>
  <script type="application/json" id="menuData">
    <%-
      JSON.stringify({
        slug: venueSlug,
        // Порядок позиций в меню: ключи объекта items — числовые, и движок JS сортирует их
        // по возрастанию, а лента "ещё из этой категории" должна идти в порядке меню.
        // Промт 2.3: список строится по allItems, а не по видимым группам — иначе прямая ссылка
        // на утреннее блюдо, открытая вечером, показала бы «позиции больше нет» вместо честной
        // карточки с подписью «доступно с 8:00».
        order: allItems.map((i) => i.id),
        items: allItems.reduce((acc, item) => {
          {
            acc[item.id] = {
              id: item.id,
              name: item.name,
              description: item.description || '',
              composition: item.composition || '',
              price: Number(item.price),
              oldPrice: item.oldPrice ? Number(item.oldPrice) : null,
              discountPercent: item.discountPercent,
              priceFrom: item.priceFrom,
              currency: item.currency,
              photoUrl: item.photoUrl || item.photoThumbUrl || null,
              photoThumbUrl: item.photoThumbUrl || null,
              groups: item.optionGroups,
              // Данные карточки блюда (промт 2.2)
              categoryId: item.categoryId,
              categoryName: item.categoryName,
              // Промт 2.3: карточка блюда подписывает расписание отдельно от «нет в наличии».
              availableNow: item.availableNow !== false,
              scheduleLabel: item.scheduleLabel || null,
              isAvailable: item.isAvailable,
              tags: item.tags,
              calories: item.calories,
              weight: item.weight,
              cookingTimeMinutes: item.cookingTimeMinutes,
              allergens: item.allergens,
              spicyLevel: item.spicyLevel,
              isPopular: item.isPopular,
            };
          }
          return acc;
        }, {}),
        initialItemId: locals.initialItemId || null,
        initialItemMissing: Boolean(locals.initialItemMissing),
        labels: {
          itemsCount: t('publicMenu.itemsCount', { count: '__COUNT__' }),
          cartEmpty: t('publicMenu.cartEmpty'),
          qtyDecrease: t('publicMenu.qtyDecreaseAriaLabel'),
          qtyIncrease: t('publicMenu.qtyIncreaseAriaLabel'),
          required: t('publicMenu.optionRequired'),
          maxReached: t('publicMenu.optionMaxReached'),
          addToCart: t('publicMenu.optionAddToCart'),
          saveLine: t('publicMenu.optionSaveLine'),
          editLine: t('publicMenu.cartLineEdit'),
          composition: t('publicMenu.compositionLabel'),
          caloriesUnit: t('publicMenu.caloriesUnit'),
          priceFrom: t('publicMenu.priceFrom'),
          cookingTime: t('publicMenu.cardCookingTime', { minutes: '__MINUTES__' }),
          allergensPrefix: t('publicMenu.cardAllergensPrefix'),
          spicyAria: t('publicMenu.cardSpicyAriaLabel', { level: '__LEVEL__', max: '__MAX__' }),
          popular: t('publicMenu.cardPopularBadge'),
          unavailable: t('publicMenu.unavailableBadge'),
          moreFromCategory: t('publicMenu.cardMoreFromCategory'),
          gone: t('publicMenu.cardItemGone'),
          backToMenu: t('publicMenu.cardBackToMenu'),
          shareCopied: t('publicMenu.shareCopied'),
          orderStatusNew: t('orders.statusNew'),
          orderStatusAccepted: t('orders.statusAccepted'),
          orderStatusDone: t('orders.statusDone'),
          orderStatusCancelled: t('orders.statusCancelled'),
          orderConfirmHeading: t('orders.confirmHeading'),
          orderSentHeading: t('orders.sentOrderNumberLabel'),
          orderGenericError: t('orders.genericError'),
          orderNetworkError: t('orders.networkError'),
          reviewCommentHigh: t('reviews.commentLabelHigh'),
          reviewCommentLow: t('reviews.commentLabelLow'),
          reviewCommentPlaceholderHigh: t('reviews.commentPlaceholderHigh'),
          reviewCommentPlaceholderLow: t('reviews.commentPlaceholderLow'),
          reviewTitleHigh: t('reviews.modalTitleHigh'),
          reviewTitleLow: t('reviews.modalTitleLow'),
          reviewMapsHintHigh: t('reviews.mapsHintHigh'),
          reviewMapsHintLow: t('reviews.mapsHintLow'),
          reviewSubmitHigh: t('reviews.submitButtonHigh'),
          reviewSubmitLow: t('reviews.submitButtonLow'),
          reviewThanks: t('reviews.thanks'),
          reviewThanksContact: t('reviews.thanksWithContact'),
          reviewAlready: t('reviews.errorAlreadyReviewed'),
          reviewGenericError: t('reviews.genericError'),
          reviewStarAria: t('reviews.starAriaLabel', { star: '__STAR__' }),
          scheduleAvailableAt: t('schedules.availableAt', { schedule: '__SCHEDULE__' }),
          scheduleOutOfSchedule: t('schedules.outOfScheduleBadge'),
        },
      }).replace(/</g, '\\u003c')
    %>
  </script>
  <script src="/js/menu-cart.js" defer></script>
  <script src="/js/dish-card.js" defer></script>
  <% if (ordersAvailable) { %><script src="/js/order-flow.js" defer></script><% } %>
  <% if (reviewsAvailable) { %><script src="/js/review-flow.js" defer></script><% } %>
  <%# Промт 2.5. Версия меню уходит в service worker через postMessage (не через URL
      регистрации): разные заведения в одном браузере делят одну область действия, и смена
      URL скрипта перерегистрировала бы воркер туда-сюда на каждом переходе между меню. %>
  <script type="application/json" id="pwaData">
    <%- JSON.stringify({
      slug: venueSlug,
      menuVersion: String(menuVersion),
      labels: {
        staleMenu: t('pwa.staleMenu'),
        updateReady: t('pwa.updateReady'),
        updateAction: t('pwa.updateAction'),
        installOffer: t('pwa.installOffer'),
        installAction: t('pwa.installAction'),
        installIos: t('pwa.installIos'),
      },
    }).replace(/</g, '\u003c') %>
  </script>
  <script src="/js/share-button.js" defer></script>
  <script src="/js/copy-button.js" defer></script>
  <script src="/js/pwa.js" defer></script>
</body>
</html>
