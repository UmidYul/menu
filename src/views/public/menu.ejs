<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= venueName %> — <%= t('publicMenu.pageTitleSuffix') %></title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #fafafa;
      color: #1a1a1a;
      margin: 0;
      padding: 0 0 2rem;
    }
    header {
      background: #fff;
      padding: 1.1rem 1rem;
      border-bottom: 1px solid #eee;
      position: sticky;
      top: 0;
      z-index: 1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
    }
    header h1 {
      font-size: 1.15rem;
      margin: 0;
    }
    .lang-switch {
      display: flex;
      gap: 0.35rem;
      flex-shrink: 0;
    }
    .lang-switch a {
      display: inline-block;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      font-size: 0.75rem;
      text-decoration: none;
      color: #555;
      background: #f0f0f0;
    }
    .lang-switch a.active {
      background: #1a1a1a;
      color: #fff;
    }
    main {
      max-width: 640px;
      margin: 0 auto;
      padding: 0 1rem;
    }
    h2.category {
      font-size: 1rem;
      color: #444;
      margin: 1.5rem 0 0.6rem;
      padding-bottom: 0.3rem;
      border-bottom: 2px solid #eee;
    }
    .item {
      display: flex;
      gap: 0.75rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid #f0f0f0;
    }
    .item.unavailable {
      opacity: 0.5;
    }
    .item img {
      width: 64px;
      height: 64px;
      border-radius: 8px;
      object-fit: cover;
      flex-shrink: 0;
      background: #eee;
    }
    .item-body {
      flex: 1;
      min-width: 0;
    }
    .item-top {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      align-items: baseline;
    }
    .item-name {
      font-weight: 600;
      font-size: 0.95rem;
    }
    .item-price {
      font-weight: 600;
      font-size: 0.95rem;
      white-space: nowrap;
    }
    .item-desc {
      font-size: 0.82rem;
      color: #666;
      margin-top: 0.2rem;
    }
    .item-tags {
      margin-top: 0.35rem;
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
    }
    .tag {
      font-size: 0.7rem;
      background: #f0f0f0;
      color: #555;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
    }
    .unavailable-badge {
      font-size: 0.7rem;
      color: #b3261e;
      background: #fdecea;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
    }
    .empty {
      padding: 2rem 0;
      text-align: center;
      color: #888;
    }
  </style>
</head>
<body>
  <header>
    <h1><%= venueName %></h1>
    <nav class="lang-switch">
      <a href="?lang=ru" class="<%= lang === 'ru' ? 'active' : '' %>">RU</a>
      <a href="?lang=uz" class="<%= lang === 'uz' ? 'active' : '' %>">UZ</a>
    </nav>
  </header>
  <main>
    <% if (groups.length === 0) { %>
      <p class="empty"><%= t('publicMenu.empty') %></p>
    <% } %>
    <% groups.forEach((group) => { %>
      <h2 class="category"><%= group.categoryName %></h2>
      <% group.items.forEach((item) => { %>
        <div class="item <%= item.isAvailable ? '' : 'unavailable' %>">
          <% if (item.photoThumbUrl) { %>
            <img src="<%= item.photoThumbUrl %>" alt="" loading="lazy">
          <% } %>
          <div class="item-body">
            <div class="item-top">
              <span class="item-name"><%= item.name %></span>
              <span class="item-price"><%= Number(item.price).toLocaleString('ru-RU') %> <%= item.currency %></span>
            </div>
            <% if (item.description) { %>
              <div class="item-desc"><%= item.description %></div>
            <% } %>
            <div class="item-tags">
              <% if (!item.isAvailable) { %>
                <span class="unavailable-badge"><%= t('publicMenu.unavailableBadge') %></span>
              <% } %>
              <% item.tags.forEach((tag) => { %>
                <span class="tag"><%= tag.label %></span>
              <% }) %>
            </div>
          </div>
        </div>
      <% }) %>
    <% }) %>
  </main>
</body>
</html>
