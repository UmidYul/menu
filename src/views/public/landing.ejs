<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('landing.metaTitle', { serviceName }) %></title>
  <meta name="description" content="<%= t('landing.metaDescription') %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <link rel="alternate" hreflang="ru" href="<%= baseUrl %>/?lang=ru">
  <link rel="alternate" hreflang="uz" href="<%= baseUrl %>/?lang=uz">
  <link rel="alternate" hreflang="x-default" href="<%= baseUrl %>/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= serviceName %>">
  <meta property="og:locale" content="<%= ogLocale %>">
  <meta property="og:title" content="<%= t('landing.metaTitle', { serviceName }) %>">
  <meta property="og:description" content="<%= t('landing.metaDescription') %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= t('landing.metaTitle', { serviceName }) %>">
  <meta name="twitter:description" content="<%= t('landing.metaDescription') %>">
  <%- include('../partials/head-assets') %>
  <script src="/js/landing.js" defer></script>
  <%
    const faqIds = [1, 2, 3, 4, 5, 6, 7, 8];
    const faqParams = { 1: { price: pricing.priceMonth } };
    const faqItems = faqIds.map((n) => ({
      q: t(`landing.faqQ${n}`),
      a: t(`landing.faqA${n}`, faqParams[n]),
    }));
  %>
  <script type="application/ld+json">
    <%- toSafeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: serviceName,
      url: baseUrl,
    }) %>
  </script>
  <script type="application/ld+json">
    <%- toSafeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: serviceName,
      description: t('landing.metaDescription'),
      offers: {
        '@type': 'Offer',
        price: pricing.priceMonthRaw,
        priceCurrency: 'UZS',
        url: canonicalUrl,
      },
    }) %>
  </script>
  <script type="application/ld+json">
    <%- toSafeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }) %>
  </script>
</head>
<body>
  <%- include('../partials/site-nav', { lang, t, isLanding: true }) %>

  <main class="landing">
    <section class="hero container">
      <div class="hero-copy">
        <div class="eyebrow" data-reveal><span class="eyebrow-dot"></span> <%= t('landing.heroEyebrow') %></div>
        <h1 data-reveal><%= t('landing.heroTitleLine1') %><br><em><%= t('landing.heroTitleLine2') %></em></h1>
        <p data-reveal data-reveal-delay="90"><%= t('landing.heroSubtitle') %></p>
        <div class="hero-actions" data-reveal data-reveal-delay="180">
          <a href="/menu/demo" class="btn btn-primary">
            <%- include('../partials/icon', { name: 'eye', size: 17 }) %> <%= t('landing.ctaDemo') %>
          </a>
          <a href="/admin/login" class="btn btn-outline"><%= t('landing.ctaLogin') %></a>
        </div>
        <p class="hero-free-note"><%= t('landing.heroFreeNote') %></p>
        <div class="trust">
          <span class="avatars"><span></span><span></span><span></span></span>
          <span><%= t('landing.heroTrustText') %></span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-card" data-reveal data-reveal-delay="250">
          <div class="hero-card-top"><span class="live-dot"></span> <%= t('landing.heroCardBadge') %> <span class="hero-card-more">•••</span></div>
          <div class="menu-preview">
            <div class="preview-logo"><%= t('landing.heroCardVenueName').charAt(0) %></div>
            <h3><%= t('landing.heroCardVenueName') %></h3>
            <p><%= t('landing.heroCardVenueTagline') %></p>
            <div class="preview-line"></div>
            <div class="preview-food"><span>🥞</span><div><b><%= t('landing.heroDish1Name') %></b><small><%= t('landing.heroDish1Desc') %></small></div><strong><%= t('landing.heroDish1Price') %></strong></div>
            <div class="preview-food"><span>🥟</span><div><b><%= t('landing.heroDish2Name') %></b><small><%= t('landing.heroDish2Desc') %></small></div><strong><%= t('landing.heroDish2Price') %></strong></div>
          </div>
        </div>
        <div class="float-note">
          <%- include('../partials/icon', { name: 'qrcode', size: 19 }) %>
          <span><b><%= t('landing.heroFloatNoteTitle') %></b><small><%= t('landing.heroFloatNoteDesc') %></small></span>
        </div>
      </div>
    </section>

    <section class="stats container">
      <div><b data-count><%= t('landing.statDaysValue') %></b><span><%= t('landing.statDaysLabel') %></span></div>
      <div><b data-count><%= t('landing.statPriceValue') %></b><span><%= t('landing.statPriceLabelFreeMonth') %></span></div>
      <div><b><%= t('landing.statAvailabilityValue') %></b><span><%= t('landing.statAvailabilityLabel') %></span></div>
      <div><b><%= t('landing.statLangValue') %></b><span><%= t('landing.statLangLabel') %></span></div>
    </section>

    <section class="section container" id="features" aria-labelledby="features-heading">
      <div class="section-heading" data-reveal>
        <span class="eyebrow"><%= t('landing.featuresEyebrow') %></span>
        <h2 id="features-heading"><%= t('landing.featuresTitleLine1') %><br><em><%= t('landing.featuresTitleLine2') %></em></h2>
      </div>
      <%
        const featureItems = [
          { icon: 'globe', key: 'featureBilingual' },
          { icon: 'image', key: 'featurePhotos' },
          { icon: 'edit', key: 'featureCategories' },
          { icon: 'sliders', key: 'featureStopList' },
          { icon: 'arrowdown', key: 'featureDiscount' },
          { icon: 'activity', key: 'featureComposition' },
          { icon: 'cart', key: 'featureCart' },
          { icon: 'qrcode', key: 'featureQr' },
          { icon: 'store', key: 'featureVenueCard' },
          { icon: 'wifi', key: 'featureContacts' },
          { icon: 'share', key: 'featureSeo' },
          { icon: 'eye', key: 'featureStats' },
        ];
      %>
      <div class="features-grid">
        <% featureItems.forEach((item, i) => { %>
          <div class="feature-card" data-reveal data-reveal-delay="<%= Math.min(i * 70, 400) %>">
            <%- include('../partials/icon', { name: item.icon, size: 24 }) %>
            <h3><%= t(`landing.${item.key}Title`) %></h3>
            <p><%= t(`landing.${item.key}Desc`) %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="section container" id="for-whom" aria-labelledby="for-whom-heading">
      <div class="section-heading" data-reveal>
        <span class="eyebrow"><%= t('landing.forWhomEyebrow') %></span>
        <h2 id="for-whom-heading"><%= t('landing.forWhomTitleLine1') %><br><em><%= t('landing.forWhomTitleLine2') %></em></h2>
      </div>
      <%
        const forWhomItems = [
          { icon: 'coffee', key: 'forWhomItem1' },
          { icon: 'utensils', key: 'forWhomItem2' },
          { icon: 'store', key: 'forWhomItem3' },
          { icon: 'glass', key: 'forWhomItem4' },
          { icon: 'cart', key: 'forWhomItem5' },
          { icon: 'heart', key: 'forWhomItem6' },
        ];
      %>
      <div class="for-whom-list">
        <% forWhomItems.forEach((item, i) => { %>
          <div class="for-whom-item" data-reveal data-reveal-delay="<%= Math.min(i * 60, 400) %>">
            <%- include('../partials/icon', { name: item.icon, size: 20 }) %>
            <span><%= t(`landing.${item.key}`) %></span>
          </div>
        <% }) %>
      </div>
      <p class="for-whom-note"><%= t('landing.forWhomNote') %></p>
    </section>

    <section class="section container" id="how" aria-labelledby="how-heading">
      <div class="section-heading" data-reveal>
        <span class="eyebrow"><%= t('landing.howEyebrow') %></span>
        <h2 id="how-heading"><%= t('landing.howTitleLine1') %><br><em><%= t('landing.howTitleLine2') %></em></h2>
      </div>
      <div class="steps">
        <div data-reveal data-reveal-delay="0">
          <span>01</span>
          <%- include('../partials/icon', { name: 'externallink', size: 22 }) %>
          <h3><%= t('landing.step1Title') %></h3>
          <p><%= t('landing.step1Desc') %></p>
        </div>
        <div data-reveal data-reveal-delay="80">
          <span>02</span>
          <%- include('../partials/icon', { name: 'qrcode', size: 22 }) %>
          <h3><%= t('landing.step2Title') %></h3>
          <p><%= t('landing.step2Desc') %></p>
        </div>
        <div data-reveal data-reveal-delay="160">
          <span>03</span>
          <%- include('../partials/icon', { name: 'utensils', size: 22 }) %>
          <h3><%= t('landing.step3Title') %></h3>
          <p><%= t('landing.step3Desc') %></p>
        </div>
      </div>
      <p class="how-free-note"><%= t('landing.howFreeNote') %></p>
    </section>

    <section class="section container" id="why" aria-labelledby="why-heading">
      <div class="section-heading" data-reveal>
        <span class="eyebrow"><%= t('landing.whyEyebrow') %></span>
        <h2 id="why-heading"><%= t('landing.whyTitleLine1') %><br><em><%= t('landing.whyTitleLine2') %></em></h2>
      </div>
      <div class="why-grid">
        <div class="why-col why-col-old">
          <h3><%= t('landing.whyColOldLabel') %></h3>
          <% [1, 2, 3, 4, 5, 6].forEach((n) => { %>
            <div class="why-row" data-reveal data-reveal-delay="<%= (n - 1) * 60 %>">
              <%- include('../partials/icon', { name: 'x', size: 16 }) %>
              <span><%= t(`landing.why${n}Old`) %></span>
            </div>
          <% }) %>
        </div>
        <div class="why-col why-col-new">
          <h3><%= t('landing.whyColNewLabel') %></h3>
          <% [1, 2, 3, 4, 5, 6].forEach((n) => { %>
            <div class="why-row" data-reveal data-reveal-delay="<%= (n - 1) * 60 %>">
              <%- include('../partials/icon', { name: 'check', size: 16 }) %>
              <span><%= t(`landing.why${n}New`) %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="pricing container" id="prices" aria-labelledby="prices-heading">
      <div class="pricing-copy" data-reveal>
        <span class="eyebrow"><%= t('landing.pricesEyebrow') %></span>
        <h2 id="prices-heading"><%= t('landing.pricesTitleLine1') %><br><em><%= t('landing.pricesTitleLine2') %></em></h2>
        <p class="pricing-intro"><%= t('landing.pricesIntro') %></p>

        <div class="pricing-free-block">
          <p class="pricing-free-heading"><%= t('landing.planFreeLine') %></p>
          <p class="pricing-free-desc"><%= t('landing.pricesFreeMonthDesc') %></p>
        </div>

        <ul class="pricing-perks">
          <li><%- include('../partials/icon', { name: 'check', size: 16 }) %> <%= t('landing.pricesPerk1') %></li>
          <li><%- include('../partials/icon', { name: 'clock', size: 16 }) %> <%= t('landing.pricesPerk2') %></li>
          <li><%- include('../partials/icon', { name: 'users', size: 16 }) %> <%= t('landing.pricesPerk3') %></li>
        </ul>

        <div class="pricing-after-free">
          <h4><%= t('landing.pricesAfterFreeHeading') %></h4>
          <p><%= t('landing.pricesAfterFreeDesc', { price: pricing.priceMonth }) %></p>
        </div>

        <% if (siteSettings && siteSettings.telegram_url) { %>
          <p class="pricing-contact">
            <%= t('landing.pricesContactText') %>
            <a href="<%= siteSettings.telegram_url %>" class="link-arrow" target="_blank" rel="noopener">
              <%= t('landing.pricesContactLink') %> <%- include('../partials/icon', { name: 'arrowright', size: 14 }) %>
            </a>
          </p>
        <% } %>
      </div>
      <% const planCtaUrl = siteSettings && siteSettings.telegram_url ? siteSettings.telegram_url : '/apply'; %>
      <div class="price-card" data-reveal data-reveal-delay="150">
        <div>
          <span class="price-badge-discount"><%= t('landing.planBadgeDiscount', { percent: pricing.discountPercent }) %></span>
          <span class="plan-label"><%= t('landing.planLabel') %></span>
          <p class="price-free-line"><%= t('landing.planFreeLine') %></p>
          <h3><span class="price-old"><%= pricing.priceMonthOld %></span> <%= pricing.priceMonth %> <small><%= t('landing.planPriceSuffix') %></small></h3>
          <p class="price-sub"><%= t('landing.planSub') %></p>
        </div>
        <ul>
          <% [1, 2, 3, 4, 5].forEach((n) => { %>
            <li><%- include('../partials/icon', { name: 'check', size: 16 }) %> <%= t(`landing.planFeature${n}`) %></li>
          <% }) %>
        </ul>
        <a href="#features" class="link-arrow price-all-features"><%= t('landing.planAllFeaturesLink') %> <%- include('../partials/icon', { name: 'arrowright', size: 14 }) %></a>
        <a href="<%= planCtaUrl %>" class="btn btn-primary"<% if (siteSettings && siteSettings.telegram_url) { %> target="_blank" rel="noopener"<% } %>><%= t('landing.planCta') %></a>
        <p class="price-payment-methods"><%= t('landing.planPaymentMethods') %></p>
        <% if (pricing.periods.length > 0) { %>
          <p class="price-discount-note"><%= t('landing.planDiscountNote', {
            price3: (pricing.periods.find((p) => p.months === '3') || {}).total,
            price6: (pricing.periods.find((p) => p.months === '6') || {}).total,
          }) %></p>
        <% } %>
      </div>
    </section>

    <section class="section faq container" id="faq" aria-labelledby="faq-heading">
      <div class="section-heading">
        <span class="eyebrow"><%= t('landing.faqEyebrow') %></span>
        <h2 id="faq-heading"><%= t('landing.faqTitleLine1') %><br><em><%= t('landing.faqTitleLine2') %></em></h2>
      </div>
      <div class="faq-list">
        <% faqItems.forEach((item, i) => { %>
          <details class="faq-item" data-reveal data-reveal-delay="<%= Math.min(i * 60, 400) %>">
            <summary>
              <span><%= item.q %></span>
              <span class="faq-icon"><%- include('../partials/icon', { name: 'arrowdown', size: 16 }) %></span>
            </summary>
            <div class="faq-content"><div class="faq-content-inner"><p><%= item.a %></p></div></div>
          </details>
        <% }) %>
      </div>
    </section>

    <section class="cta-final container" id="cta" aria-labelledby="cta-heading" data-reveal>
      <span class="eyebrow"><%= t('landing.ctaFinalEyebrow') %></span>
      <h2 id="cta-heading"><%= t('landing.ctaFinalTitle') %></h2>
      <p><%= t('landing.ctaFinalText') %></p>
      <div class="cta-final-actions">
        <a href="/menu/demo" class="btn btn-primary">
          <%- include('../partials/icon', { name: 'eye', size: 17 }) %> <%= t('landing.ctaDemo') %>
        </a>
        <% if (siteSettings && siteSettings.telegram_url) { %>
          <a href="<%= siteSettings.telegram_url %>" class="btn btn-ghost" target="_blank" rel="noopener">
            <%- include('../partials/icon', { name: 'telegram', size: 17 }) %> <%= t('landing.ctaFinalTelegramBtn') %>
          </a>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/site-footer', { lang, t, serviceName, siteSettings, isLanding: true }) %>
</body>
</html>
