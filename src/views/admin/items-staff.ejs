<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('nav.availability') %></title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f4f5f7; margin: 0; padding: 2rem; }
    header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    nav { margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    nav a { color: #1a73e8; text-decoration: none; margin-right: 1rem; font-size: 0.9rem; }
    .lang-switch a { margin-right: 0.35rem; padding: 0.2rem 0.5rem; border-radius: 999px; background: #eee; color: #555; font-size: 0.75rem; }
    .lang-switch a.active { background: #1a1a1a; color: #fff; }
    h1 { font-size: 1.25rem; margin: 0; }
    h2 { font-size: 1.05rem; margin: 1.5rem 0 0.75rem; }
    .role { color: #666; font-size: 0.85rem; }
    button { padding: 0.5rem 1rem; border: 1px solid #ccc; border-radius: 6px; cursor: pointer; font-size: 0.9rem; }
    button.toggle-on { background: #e6f4ea; color: #1a7f37; border-color: #b7e1c1; }
    button.toggle-off { background: #fdecea; color: #b3261e; border-color: #f5c6c2; }
    .row { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 0.9rem 1.1rem; border-radius: 10px; box-shadow: 0 1px 6px rgba(0,0,0,0.05); margin-bottom: 0.6rem; max-width: 560px; }
    .row.unavailable { opacity: 0.6; }
    .name { font-weight: 500; }
    .desc { font-size: 0.8rem; color: #777; margin-top: 0.15rem; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1><%= t('nav.availability') %></h1>
      <div class="role"><%= t('common.loggedInAs') %> <%= login %> (<%= t('roles.staff') %>)</div>
    </div>
    <form method="POST" action="/admin/logout">
      <button type="submit"><%= t('common.logout') %></button>
    </form>
  </header>
  <nav>
    <a href="/admin"><%= t('nav.dashboard') %></a>
    <a href="/admin/items"><%= t('nav.availability') %></a>
    <div class="lang-switch">
      <a href="/admin/lang?lang=ru&redirect=/admin/items" class="<%= lang === 'ru' ? 'active' : '' %>">RU</a>
      <a href="/admin/lang?lang=uz&redirect=/admin/items" class="<%= lang === 'uz' ? 'active' : '' %>">UZ</a>
    </div>
  </nav>

  <% if (groups.length === 0) { %>
    <p><%= t('items.empty') %></p>
  <% } %>

  <% groups.forEach((group) => { %>
    <h2><%= group.categoryName %></h2>
    <% group.items.forEach((item) => { %>
      <div class="row <%= item.is_available ? '' : 'unavailable' %>">
        <div style="display:flex; align-items:center; gap:0.7rem;">
          <% if (item.photo_thumb_url) { %>
            <img src="<%= item.photo_thumb_url %>" alt="" style="width:44px;height:44px;object-fit:cover;border-radius:8px;flex-shrink:0;">
          <% } %>
          <div>
            <div class="name"><%= item.displayName %></div>
            <% if (item.displayDescription) { %>
              <div class="desc"><%= item.displayDescription %></div>
            <% } %>
          </div>
        </div>
        <form method="POST" action="/admin/items/<%= item.id %>/toggle">
          <button type="submit" class="<%= item.is_available ? 'toggle-on' : 'toggle-off' %>">
            <%= item.is_available ? t('items.available') : t('items.unavailable') %>
          </button>
        </form>
      </div>
    <% }) %>
  <% }) %>
</body>
</html>
