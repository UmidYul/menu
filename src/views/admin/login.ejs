<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('login.pageTitle') %></title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f4f5f7; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .card { background: #fff; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); width: 100%; max-width: 360px; position: relative; }
    .lang-switch { position: absolute; top: 1rem; right: 1rem; display: flex; gap: 0.35rem; }
    .lang-switch a { font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 999px; background: #f0f0f0; color: #555; text-decoration: none; }
    .lang-switch a.active { background: #1a1a1a; color: #fff; }
    h1 { font-size: 1.25rem; margin: 0 0 1.25rem; }
    label { display: block; font-size: 0.875rem; margin-bottom: 0.25rem; color: #333; }
    input { width: 100%; padding: 0.6rem; margin-bottom: 1rem; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; font-size: 1rem; }
    button { width: 100%; padding: 0.65rem; background: #1a73e8; color: #fff; border: none; border-radius: 6px; font-size: 1rem; cursor: pointer; }
    button:hover { background: #1558b0; }
    .error { background: #fdecea; color: #b3261e; padding: 0.6rem 0.8rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="card">
    <nav class="lang-switch">
      <a href="/admin/lang?lang=ru&redirect=/admin/login" class="<%= lang === 'ru' ? 'active' : '' %>">RU</a>
      <a href="/admin/lang?lang=uz&redirect=/admin/login" class="<%= lang === 'uz' ? 'active' : '' %>">UZ</a>
    </nav>
    <h1><%= t('login.heading') %></h1>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/admin/login">
      <label for="login"><%= t('login.loginLabel') %></label>
      <input type="text" id="login" name="login" value="<%= login %>" autocomplete="username" required>

      <label for="password"><%= t('login.passwordLabel') %></label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>

      <button type="submit"><%= t('login.submit') %></button>
    </form>
  </div>
</body>
</html>
