<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('login.pageTitle') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="auth-lang lang">
        <a href="/admin/lang?lang=ru&redirect=/admin/login" class="<%= lang === 'ru' ? 'active' : '' %>">RU</a>
        <a href="/admin/lang?lang=uz&redirect=/admin/login" class="<%= lang === 'uz' ? 'active' : '' %>">UZ</a>
      </div>
      <div class="brand" style="margin-bottom:22px;"><%- include('../partials/brand', { compact: true }) %></div>
      <h1><%= t('login.heading') %></h1>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="POST" action="/admin/login">
        <div class="field">
          <label for="login"><%= t('login.loginLabel') %></label>
          <input type="text" id="login" name="login" value="<%= login %>" autocomplete="username" required>
        </div>
        <div class="field">
          <label for="password"><%= t('login.passwordLabel') %></label>
          <input type="password" id="password" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('login.submit') %></button>
      </form>
    </div>
  </div>
</body>
</html>
