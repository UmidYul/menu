<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('login.accessPageTitle') %></title>
  <%- include('../partials/head-assets') %>
</head>
<%# Промт 3.5: у официанта сайдбара админки нет — он попадает сюда сразу после приглашения
    и не должен видеть разделы, куда ему всё равно закрыт вход. Оболочка разная, содержимое
    формы — общее, дублировать её ради шапки незачем. %>
<% const _isStaff = role === 'staff'; %>
<body class="<%= _isStaff ? 'staff-body' : '' %>">
  <div class="<%= _isStaff ? 'staff-shell' : 'admin-shell' %>">
    <% if (_isStaff) { %>
      <%- include('../partials/staff-header', {
        active: 'password',
        venueName: venue ? venue.name : '',
        displayName,
        ordersEnabled: Boolean(venue && venue.orders_enabled && venue.telegram_chat_id && !venue.telegram_chat_broken),
        lang, t, csrfToken,
      }) %>
    <% } else { %>
      <%- include('../partials/admin-sidebar', { role, login, active: 'password', venueSlug: venue ? venue.slug : null, lang, t }) %>
    <% } %>
    <section class="<%= _isStaff ? 'staff-main' : 'admin-main' %>">
      <% if (!_isStaff) { %>
        <%- include('../partials/admin-topbar', { crumb: venue ? venue.name : t('roles.superadmin'), section: t('login.accessHeading'), lang, currentPath: '/admin/password', venueSlug: venue ? venue.slug : null, t }) %>
      <% } %>
      <div class="<%= _isStaff ? 'staff-content' : 'admin-content' %>">
        <% if (!_isStaff) { %>
          <div class="welcome">
            <div>
              <span class="eyebrow"><%= venue ? venue.name : t('roles.superadmin') %></span>
              <h1><%= t('login.accessHeading') %></h1>
            </div>
          </div>
        <% } %>

        <% if (error) { %>
          <div class="alert alert-error" style="max-width:560px; margin-inline:auto;"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="alert alert-success" style="max-width:560px; margin-inline:auto;"><%= success %></div>
        <% } %>

        <div class="form-card" style="max-width:560px; margin-inline:auto;">
          <div class="card-header">
            <div><span class="eyebrow"><%- include('../partials/icon', { name: 'key', size: 15 }) %></span><h3><%= t('login.changePasswordHeading') %></h3></div>
          </div>
          <form method="POST" action="/admin/password">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label for="current_password"><%= t('login.currentPasswordLabel') %></label>
              <input type="password" id="current_password" name="current_password" autocomplete="current-password" required>
            </div>
            <div class="field">
              <label for="new_password"><%= t('login.newPasswordLabel') %></label>
              <input type="password" id="new_password" name="new_password" autocomplete="new-password" minlength="8" required>
              <div class="password-strength" data-strength-for="new_password"
                   data-label-weak="<%= t('login.passwordStrengthWeak') %>"
                   data-label-medium="<%= t('login.passwordStrengthMedium') %>"
                   data-label-strong="<%= t('login.passwordStrengthStrong') %>"></div>
              <div class="hint"><%= t('login.newPasswordHint') %></div>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('login.changePasswordSubmit') %></button>
          </form>
        </div>

        <% if (telegramLinkState) { %>
          <div class="form-card" style="max-width:560px; margin-inline:auto;">
            <div class="card-header">
              <div><span class="eyebrow"><%- include('../partials/icon', { name: 'telegram', size: 15 }) %></span><h3><%= t('login.telegramLinkHeading') %></h3></div>
            </div>

            <% if (telegramLinkState.linked) { %>
              <p class="auth-hint"><%= t('login.telegramLinkedText') %></p>
              <form method="POST" action="/admin/password/telegram-link/unlink" data-confirm="<%= t('login.telegramUnlinkConfirm') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger">
                  <%- include('../partials/icon', { name: 'unlink', size: 15 }) %>
                  <%= t('login.telegramUnlinkButton') %>
                </button>
              </form>
            <% } else if (!telegramLinkState.botConfigured) { %>
              <p class="auth-hint"><%= t('login.telegramLinkUnavailable') %></p>
            <% } else if (telegramLinkState.code) { %>
              <p class="auth-hint"><%= t('login.telegramLinkCodeHint') %></p>
              <div class="wifi-field">
                <span class="wifi-field-label"><%= t('login.telegramLinkCodeLabel') %></span>
                <div class="wifi-field-value wifi-field-value-password">
                  <span id="telegram-link-code"><%= telegramLinkState.code %></span>
                  <button type="button" class="wifi-copy-btn" data-copy-target="telegram-link-code" data-copy-note="telegram-link-code-copied" aria-label="<%= t('common.copy') %>">
                    <%- include('../partials/icon', { name: 'copy', size: 16 }) %>
                  </button>
                </div>
              </div>
              <span id="telegram-link-code-copied" class="copied" hidden>
                <%- include('../partials/icon', { name: 'check', size: 13 }) %> <%= t('login.telegramCodeCopied') %>
              </span>
              <a href="<%= telegramLinkState.botLink %>" target="_blank" rel="noopener" class="btn btn-primary" style="width:100%;">
                <%- include('../partials/icon', { name: 'telegram', size: 15 }) %>
                <%= t('login.telegramOpenBotButton') %>
              </a>
              <form method="POST" action="/admin/password/telegram-link/generate" style="margin-top:10px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-outline" style="width:100%;"><%= t('login.telegramRegenerateButton') %></button>
              </form>
            <% } else { %>
              <p class="auth-hint"><%= t('login.telegramLinkIntro') %></p>
              <form method="POST" action="/admin/password/telegram-link/generate">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-primary" style="width:100%;">
                  <%- include('../partials/icon', { name: 'link', size: 15 }) %>
                  <%= t('login.telegramGenerateButton') %>
                </button>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </div>
  <script src="/js/password-strength.js"></script>
  <script src="/js/copy-button.js"></script>
</body>
</html>
