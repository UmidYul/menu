<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('categories.pageTitle') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { role, login, active: 'categories', venueSlug, lang, t }) %>
    <section class="admin-main">
      <%- include('../partials/admin-topbar', { crumb: t('nav.dashboard'), section: t('categories.heading'), lang, currentPath: '/admin/categories', venueSlug, t }) %>
      <div class="admin-content">
        <div class="welcome">
          <div><span class="eyebrow"><%= t('categories.eyebrow') %></span><h1><%= t('categories.heading') %></h1></div>
          <button type="button" class="btn btn-primary" onclick="document.getElementById('add-category-modal').showModal()">
            <%- include('../partials/icon', { name: 'plus', size: 15 }) %> <%= t('categories.addHeading') %>
          </button>
        </div>

        <div style="max-width:760px; margin-inline:auto;">
          <% if (error && !formTarget) { %>
            <div class="alert alert-error"><%= error %></div>
          <% } %>

          <% if (categories.length === 0) { %>
            <p style="color:var(--muted); font-size:13px;"><%= t('categories.empty') %></p>
          <% } %>

          <% if (categories.length > 0) { %>
            <div class="table-card">
              <% categories.forEach((category, index) => { %>
                <div class="table-row item-row" style="grid-template-columns: 1fr 40px;">
                  <div class="item-row-info">
                    <b><%= category.name_ru %></b>
                    <span><%= t('categories.itemsCount', { count: category.item_count }) %></span>
                  </div>
                  <details class="item-menu">
                    <summary aria-label="<%= t('common.actions') %>">
                      <%- include('../partials/icon', { name: 'more', size: 18 }) %>
                    </summary>
                    <div class="item-menu-panel">
                      <button type="button" onclick="this.closest('details').removeAttribute('open'); document.getElementById('edit-category-<%= category.id %>-modal').showModal()">
                        <%- include('../partials/icon', { name: 'edit', size: 14 }) %> <%= t('common.edit') %>
                      </button>
                      <form method="POST" action="/admin/categories/<%= category.id %>/move">
                        <input type="hidden" name="direction" value="up">
                        <button type="submit" <%= index === 0 ? 'disabled' : '' %>>
                          <%- include('../partials/icon', { name: 'arrowup', size: 14 }) %> <%= t('categories.moveUp') %>
                        </button>
                      </form>
                      <form method="POST" action="/admin/categories/<%= category.id %>/move">
                        <input type="hidden" name="direction" value="down">
                        <button type="submit" <%= index === categories.length - 1 ? 'disabled' : '' %>>
                          <%- include('../partials/icon', { name: 'arrowdown', size: 14 }) %> <%= t('categories.moveDown') %>
                        </button>
                      </form>
                      <hr>
                      <form method="POST" action="/admin/categories/<%= category.id %>?_method=DELETE"
                            onsubmit="return confirm('<%= t('categories.confirmDelete', { name: category.name_ru }) %>');">
                        <button type="submit" class="danger"><%- include('../partials/icon', { name: 'trash', size: 14 }) %> <%= t('common.delete') %></button>
                      </form>
                    </div>
                  </details>
                </div>
              <% }) %>
            </div>
          <% } %>

          <% categories.forEach((category) => { %>
            <dialog id="edit-category-<%= category.id %>-modal" class="modal">
              <div class="modal-head">
                <h3><%= t('categories.editHeading') %></h3>
                <button type="button" class="modal-close" onclick="this.closest('dialog').close()">
                  <%- include('../partials/icon', { name: 'x', size: 18 }) %>
                </button>
              </div>
              <div class="modal-body">
                <% if (formTarget === `edit-${category.id}`) { %>
                  <div class="alert alert-error"><%= error %></div>
                <% } %>
                <form method="POST" action="/admin/categories/<%= category.id %>?_method=PATCH">
                  <div class="field">
                    <label><%= t('categories.nameRuLabel') %></label>
                    <input type="text" name="name_ru" value="<%= category.name_ru %>" required>
                  </div>
                  <div class="field">
                    <label><%= t('categories.nameUzLabel') %></label>
                    <input type="text" name="name_uz" value="<%= category.name_uz %>" required>
                  </div>
                  <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('common.save') %></button>
                </form>
              </div>
            </dialog>
            <% if (formTarget === `edit-${category.id}`) { %>
              <script>document.getElementById('edit-category-<%= category.id %>-modal').showModal();</script>
            <% } %>
          <% }) %>
        </div>

        <dialog id="add-category-modal" class="modal">
          <div class="modal-head">
            <h3><%= t('categories.addHeading') %></h3>
            <button type="button" class="modal-close" onclick="this.closest('dialog').close()">
              <%- include('../partials/icon', { name: 'x', size: 18 }) %>
            </button>
          </div>
          <div class="modal-body">
            <% if (formTarget === 'add') { %>
              <div class="alert alert-error"><%= error %></div>
            <% } %>
            <form method="POST" action="/admin/categories">
              <div class="field">
                <label for="name_ru"><%= t('categories.nameRuLabel') %></label>
                <input type="text" id="name_ru" name="name_ru" value="<%= formValues.name_ru %>" required>
              </div>
              <div class="field">
                <label for="name_uz"><%= t('categories.nameUzLabel') %></label>
                <input type="text" id="name_uz" name="name_uz" value="<%= formValues.name_uz %>" required>
              </div>
              <button type="submit" class="btn btn-primary" style="width:100%;"><%- include('../partials/icon', { name: 'plus', size: 15 }) %> <%= t('common.add') %></button>
            </form>
          </div>
        </dialog>
        <% if (formTarget === 'add') { %>
          <script>document.getElementById('add-category-modal').showModal();</script>
        <% } %>
      </div>
    </section>
  </div>
</body>
</html>
