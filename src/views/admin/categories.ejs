<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('categories.pageTitle') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { role, login, active: 'categories', venueSlug, lang, t }) %>
    <section class="admin-main">
      <%- include('../partials/admin-topbar', { crumb: t('nav.dashboard'), section: t('categories.heading'), lang, currentPath: '/admin/categories', venueSlug, t }) %>
      <div class="admin-content">
        <div class="welcome">
          <div><span class="eyebrow"><%= t('categories.eyebrow') %></span><h1><%= t('categories.heading') %></h1></div>
          <button type="button" class="btn btn-primary" data-modal-open="add-category-modal">
            <%- include('../partials/icon', { name: 'plus', size: 15 }) %> <%= t('categories.addHeading') %>
          </button>
        </div>

        <div style="max-width:760px; margin-inline:auto;">
          <% if (error && !formTarget) { %>
            <div class="alert alert-error"><%= error %></div>
          <% } %>

          <% if (categories.length === 0) { %>
            <div class="empty-state">
              <div class="empty-state-icons">
                <span class="empty-state-icon"><%- include('../partials/icon', { name: 'list', size: 22 }) %></span>
              </div>
              <h3><%= t('categories.emptyHeading') %></h3>
              <p><%= t('categories.emptyExplain') %></p>
              <p class="empty-state-example"><%= t('categories.emptyExample') %></p>
              <button type="button" class="btn btn-primary" data-modal-open="add-category-modal">
                <%- include('../partials/icon', { name: 'plus', size: 15 }) %> <%= t('categories.emptyCreateFirst') %>
              </button>
              <form method="POST" action="/admin/categories/demo-fill" style="margin-top:12px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-outline"><%= t('categories.demoFillButton') %></button>
              </form>
            </div>
          <% } %>

          <% if (categories.some((c) => c.is_demo)) { %>
            <div class="alert alert-success" style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
              <span><%= t('categories.demoActiveNotice') %></span>
              <form method="POST" action="/admin/categories/demo-remove" data-confirm="<%= t('categories.demoRemoveConfirm') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-outline btn-sm">
                  <%- include('../partials/icon', { name: 'trash', size: 13 }) %> <%= t('categories.demoRemoveButton') %>
                </button>
              </form>
            </div>
          <% } %>

          <% if (categories.length > 0) { %>
            <div class="table-card">
              <% categories.forEach((category, index) => { %>
                <div class="table-row item-row" style="grid-template-columns: 1fr 40px;">
                  <div class="item-row-info">
                    <b><%= category.name_ru %> <% if (category.is_demo) { %><span class="dish-row-tag"><%= t('categories.demoBadge') %></span><% } %></b>
                    <span><%= t('categories.itemsCount', { count: category.item_count }) %></span>
                  </div>
                  <details class="item-menu">
                    <summary aria-label="<%= t('common.actions') %>">
                      <%- include('../partials/icon', { name: 'more', size: 18 }) %>
                    </summary>
                    <div class="item-menu-panel">
                      <button type="button" data-modal-open="edit-category-<%= category.id %>-modal">
                        <%- include('../partials/icon', { name: 'edit', size: 14 }) %> <%= t('common.edit') %>
                      </button>
                      <form method="POST" action="/admin/categories/<%= category.id %>/move">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="direction" value="up">
                        <button type="submit" <%= index === 0 ? 'disabled' : '' %>>
                          <%- include('../partials/icon', { name: 'arrowup', size: 14 }) %> <%= t('categories.moveUp') %>
                        </button>
                      </form>
                      <form method="POST" action="/admin/categories/<%= category.id %>/move">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="direction" value="down">
                        <button type="submit" <%= index === categories.length - 1 ? 'disabled' : '' %>>
                          <%- include('../partials/icon', { name: 'arrowdown', size: 14 }) %> <%= t('categories.moveDown') %>
                        </button>
                      </form>
                      <hr>
                      <form method="POST" action="/admin/categories/<%= category.id %>?_method=DELETE"
                            data-confirm="<%= t('categories.confirmDelete', { name: category.name_ru }) %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="danger"><%- include('../partials/icon', { name: 'trash', size: 14 }) %> <%= t('common.delete') %></button>
                      </form>
                    </div>
                  </details>
                </div>
              <% }) %>
            </div>
          <% } %>

          <% categories.forEach((category) => { %>
            <dialog id="edit-category-<%= category.id %>-modal" class="modal" <%= (formTarget === `edit-${category.id}` || (scheduleError && scheduleCategoryId === category.id)) ? "data-autoopen" : "" %>>
              <div class="modal-head">
                <h3><%= t('categories.editHeading') %></h3>
                <button type="button" class="modal-close" data-modal-close>
                  <%- include('../partials/icon', { name: 'x', size: 18 }) %>
                </button>
              </div>
              <div class="modal-body">
                <% if (formTarget === `edit-${category.id}`) { %>
                  <div class="alert alert-error"><%= error %></div>
                <% } %>
                <form method="POST" action="/admin/categories/<%= category.id %>?_method=PATCH">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="field">
                    <label><%= t('categories.nameRuLabel') %></label>
                    <input type="text" name="name_ru" value="<%= category.name_ru %>" required>
                  </div>
                  <div class="field">
                    <label><%= t('categories.nameUzLabel') %></label>
                    <input type="text" name="name_uz" value="<%= category.name_uz %>" required>
                  </div>
                  <% if (enabledLangs.includes('en')) { %>
                  <div class="field">
                    <label><%= t('categories.nameEnLabel') %></label>
                    <input type="text" name="name_en" value="<%= category.name_en || '' %>">
                  </div>
                  <% } %>
                  <%# Промт 2.3: режим показа того, что сейчас вне расписания, — настройка
                      категории. Лежит в основной форме категории, а не в блоке расписания:
                      это свойство самой категории, оно осмысленно и без интервалов. %>
                  <div class="field">
                    <label for="schedule_hidden_mode_<%= category.id %>"><%= t('schedules.hiddenModeLabel') %></label>
                    <select id="schedule_hidden_mode_<%= category.id %>" name="schedule_hidden_mode">
                      <% ['dim', 'hide', 'section'].forEach((mode) => { %>
                        <option value="<%= mode %>" <%= category.schedule_hidden_mode === mode ? 'selected' : '' %>><%= t('schedules.hiddenMode_' + mode) %></option>
                      <% }) %>
                    </select>
                    <div class="hint"><%= t('schedules.hiddenModeHint') %></div>
                  </div>
                  <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('common.save') %></button>
                </form>

                <%# Расписание — соседняя форма, а не вложенная: вложенные <form> запрещены. %>
                <%- include('../partials/schedule-editor', {
                  targetType: 'category',
                  targetId: category.id,
                  rules: schedulesByCategory.get(category.id) || [],
                  availableNow: scheduleStateByCategory.get(category.id).availableNow,
                  warnings: scheduleStateByCategory.get(category.id).warnings,
                  maxRules: maxScheduleRules,
                  error: scheduleError && scheduleCategoryId === category.id ? scheduleError : null,
                  t, csrfToken,
                }) %>
              </div>
            </dialog>
          <% }) %>
        </div>

        <dialog id="add-category-modal" class="modal" <%= (formTarget === 'add') ? "data-autoopen" : "" %>>
          <div class="modal-head">
            <h3><%= t('categories.addHeading') %></h3>
            <button type="button" class="modal-close" data-modal-close>
              <%- include('../partials/icon', { name: 'x', size: 18 }) %>
            </button>
          </div>
          <div class="modal-body">
            <% if (formTarget === 'add') { %>
              <div class="alert alert-error"><%= error %></div>
            <% } %>
            <form method="POST" action="/admin/categories">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field">
                <label for="name_ru"><%= t('categories.nameRuLabel') %></label>
                <input type="text" id="name_ru" name="name_ru" value="<%= formValues.name_ru %>" required>
              </div>
              <div class="field">
                <label for="name_uz"><%= t('categories.nameUzLabel') %></label>
                <input type="text" id="name_uz" name="name_uz" value="<%= formValues.name_uz %>" required>
              </div>
              <% if (enabledLangs.includes('en')) { %>
              <div class="field">
                <label for="name_en"><%= t('categories.nameEnLabel') %></label>
                <input type="text" id="name_en" name="name_en" value="<%= formValues.name_en || '' %>">
              </div>
              <% } %>
              <button type="submit" class="btn btn-primary" style="width:100%;"><%- include('../partials/icon', { name: 'plus', size: 15 }) %> <%= t('common.add') %></button>
            </form>
          </div>
        </dialog>
      </div>
    </section>
  </div>
  <script src="/js/schedule-editor.js" defer></script>
</body>
</html>
