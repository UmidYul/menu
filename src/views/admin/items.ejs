<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('items.pageTitle') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { role, login, active: 'items', venueSlug, lang, t }) %>
    <section class="admin-main">
      <%- include('../partials/admin-topbar', { crumb: t('nav.dashboard'), section: t('items.heading'), lang, currentPath: '/admin/items', venueSlug, t }) %>
      <div class="admin-content">
        <div class="welcome">
          <div><span class="eyebrow"><%= t('nav.items') %></span><h1><%= t('items.heading') %></h1></div>
          <button type="button" class="btn btn-primary" onclick="document.getElementById('add-item-modal').showModal()">
            <%- include('../partials/icon', { name: 'plus', size: 15 }) %> <%= t('items.addHeading') %>
          </button>
        </div>

        <div style="max-width:760px; margin-inline:auto;">
          <% if (error && !formTarget) { %>
            <div class="alert alert-error"><%= error %></div>
          <% } %>

          <% if (groups.length === 0) { %>
            <p style="color:var(--muted); font-size:13px;"><%= t('items.empty') %></p>
          <% } %>

          <% groups.forEach((group) => { %>
            <h3 style="font-family: var(--font-serif); font-size: 20px; font-weight: 500; margin: 30px 0 12px;"><%= group.categoryName %></h3>
            <div class="table-card" style="margin-bottom: 14px;">
              <% group.items.forEach((item) => { %>
                <div class="table-row item-row" style="grid-template-columns: 48px 1fr auto 44px 40px;">
                  <% if (item.photo_thumb_url) { %>
                    <span class="table-emoji item-thumb"><img src="<%= item.photo_thumb_url %>" alt=""></span>
                  <% } else { %>
                    <span class="table-emoji item-thumb"><%- include('../partials/icon', { name: 'utensils', size: 20 }) %></span>
                  <% } %>
                  <div class="item-row-info">
                    <b><%= item.name_ru %></b>
                    <% if (item.description_ru) { %><span><%= item.description_ru %></span><% } %>
                  </div>
                  <strong class="price"><%= Number(item.price).toLocaleString('ru-RU') %> <%= item.currency %></strong>
                  <form class="inline" method="POST" action="/admin/items/<%= item.id %>/toggle">
                    <button type="submit" class="toggle <%= item.is_available ? 'on' : '' %>" aria-label="<%= item.is_available ? t('items.available') : t('items.unavailable') %>"><i></i></button>
                  </form>
                  <details class="item-menu">
                    <summary aria-label="<%= t('common.actions') %>">
                      <%- include('../partials/icon', { name: 'more', size: 18 }) %>
                    </summary>
                    <div class="item-menu-panel">
                      <button type="button" onclick="this.closest('details').removeAttribute('open'); document.getElementById('edit-item-<%= item.id %>-modal').showModal()">
                        <%- include('../partials/icon', { name: 'edit', size: 14 }) %> <%= t('common.edit') %>
                      </button>
                      <form method="POST" action="/admin/items/<%= item.id %>?_method=DELETE"
                            onsubmit="return confirm('<%= t('items.confirmDelete', { name: item.name_ru }) %>');">
                        <button type="submit" class="danger"><%- include('../partials/icon', { name: 'trash', size: 14 }) %> <%= t('common.delete') %></button>
                      </form>
                    </div>
                  </details>
                </div>
              <% }) %>
            </div>

            <% group.items.forEach((item) => { %>
              <dialog id="edit-item-<%= item.id %>-modal" class="modal">
                <div class="modal-head">
                  <h3><%= t('items.editHeading') %></h3>
                  <button type="button" class="modal-close" onclick="this.closest('dialog').close()">
                    <%- include('../partials/icon', { name: 'x', size: 18 }) %>
                  </button>
                </div>
                <div class="modal-body">
                  <% if (formTarget === `edit-${item.id}`) { %>
                    <div class="alert alert-error"><%= error %></div>
                  <% } %>
                  <form method="POST" action="/admin/items/<%= item.id %>?_method=PATCH" enctype="multipart/form-data">
                    <input type="hidden" name="category_id" value="<%= item.category_id %>">
                    <%
                      const editValues = {
                        name_ru: item.name_ru,
                        name_uz: item.name_uz,
                        description_ru: item.description_ru || '',
                        description_uz: item.description_uz || '',
                        composition_ru: item.composition_ru || '',
                        composition_uz: item.composition_uz || '',
                        calories: (item.calories === null || item.calories === undefined) ? '' : item.calories,
                        price: item.price,
                        old_price: (item.old_price === null || item.old_price === undefined) ? '' : item.old_price,
                        currency: item.currency,
                        tags: item.tags,
                      };
                    %>
                    <%- include('../partials/item-form-fields', { v: editValues, t, allowedTags, photoLabel: t('items.photoLabel') }) %>
                    <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('common.save') %></button>
                  </form>
                </div>
              </dialog>
              <% if (formTarget === `edit-${item.id}`) { %>
                <script>document.getElementById('edit-item-<%= item.id %>-modal').showModal();</script>
              <% } %>
            <% }) %>
          <% }) %>
        </div>

        <dialog id="add-item-modal" class="modal">
          <div class="modal-head">
            <h3><%= t('items.addHeading') %></h3>
            <button type="button" class="modal-close" onclick="this.closest('dialog').close()">
              <%- include('../partials/icon', { name: 'x', size: 18 }) %>
            </button>
          </div>
          <div class="modal-body">
            <% if (formTarget === 'add') { %>
              <div class="alert alert-error"><%= error %></div>
            <% } %>
            <form method="POST" action="/admin/items" enctype="multipart/form-data">
              <div class="field">
                <label for="category_id"><%= t('items.categoryLabel') %></label>
                <select id="category_id" name="category_id" required>
                  <option value=""><%= t('items.categoryPlaceholder') %></option>
                  <% categories.forEach((category) => { %>
                    <option value="<%= category.id %>" <%= String(formValues.category_id) === String(category.id) ? 'selected' : '' %>>
                      <%= category.name_ru %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <%- include('../partials/item-form-fields', { v: formValues, t, allowedTags, photoLabel: t('items.photoOptionalLabel') }) %>
              <button type="submit" class="btn btn-primary" style="width:100%;"><%- include('../partials/icon', { name: 'plus', size: 15 }) %> <%= t('common.add') %></button>
            </form>
          </div>
        </dialog>
        <% if (formTarget === 'add') { %>
          <script>document.getElementById('add-item-modal').showModal();</script>
        <% } %>
      </div>
    </section>
  </div>
</body>
</html>
