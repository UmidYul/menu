<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= venue.name %> — <%= t('nav.dashboard') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { role, login, active: 'dashboard', venueSlug: venue.slug, lang, t }) %>
    <section class="admin-main">
      <%- include('../partials/admin-topbar', { crumb: venue.name, section: t('nav.dashboard'), lang, currentPath: '/admin', venueSlug: venue.slug, t }) %>
      <div class="admin-content">
        <div class="welcome">
          <div>
            <span class="eyebrow"><%= venue.name %></span>
            <h1><%= t('nav.dashboard') %></h1>
          </div>
          <a href="/menu/<%= venue.slug %>" target="_blank" rel="noopener" class="btn btn-primary">
            <%- include('../partials/icon', { name: 'externallink', size: 16 }) %>
            <%= t('nav.openMenu') %>
          </a>
        </div>

        <% if (!venue.is_active) { %>
          <div class="alert alert-error"><%= t('dashboard.venueDisabledNotice') %></div>
        <% } %>

        <div class="dashboard-grid">
          <div class="dashboard-card qr-card">
            <div class="card-header">
              <div>
                <span class="eyebrow"><%= t('dashboard.qrEyebrow') %></span>
                <h3><%= venue.name %></h3>
              </div>
            </div>
            <div class="qr-row">
              <img class="qr-image" src="/admin/qr.png" alt="QR" width="120" height="120">
              <div>
                <p><%= t('dashboard.qrScanHintLine1') %><br><%= t('dashboard.qrScanHintLine2') %></p>
                <button type="button" class="btn btn-outline" id="shareQrBtn" data-url="/menu/<%= venue.slug %>">
                  <%- include('../partials/icon', { name: 'share', size: 15 }) %>
                  <%= t('dashboard.shareButton') %>
                </button>
                <span id="qrCopiedNote" class="copied" style="display:none;"><%= t('dashboard.linkCopied') %></span>
              </div>
            </div>
          </div>

          <div class="dashboard-card">
            <div class="card-header">
              <div>
                <span class="eyebrow"><%= t('dashboard.viewsEyebrow') %></span>
                <h3><%= t('dashboard.viewsTitle') %></h3>
              </div>
              <%- include('../partials/icon', { name: 'barchart', size: 21 }) %>
            </div>
            <div class="metric">
              <%= stats.totalThisMonth %>
              <% if (stats.trend !== null) { %>
                <span><%= stats.trend >= 0 ? '+' : '' %><%= stats.trend %>%</span>
              <% } %>
            </div>
            <div class="chart">
              <% stats.daily.forEach((day) => { %>
                <i style="height: <%= day.heightPercent %>%;" title="<%= day.label %>: <%= day.count %>"></i>
              <% }) %>
            </div>
            <small>
              <% stats.daily.forEach((day) => { %><span><%= day.label %></span><% }) %>
            </small>
          </div>
        </div>

        <div class="table-card">
          <div class="table-heading">
            <div>
              <span class="eyebrow"><%= t('dashboard.recentItemsEyebrow') %></span>
              <h3><%= t('dashboard.recentItemsTitle') %></h3>
            </div>
            <a href="/admin/items" class="btn btn-outline">
              <%= t('dashboard.viewAllItems') %>
              <%- include('../partials/icon', { name: 'arrowright', size: 15 }) %>
            </a>
          </div>
          <% if (recentItems.length === 0) { %>
            <div style="padding: 26px; color: var(--muted); font-size: 13px;"><%= t('dashboard.noItemsYet') %></div>
          <% } %>
          <% recentItems.forEach((item) => { %>
            <div class="table-row" style="grid-template-columns: 38px 1.5fr 1.1fr .8fr 100px;">
              <% if (item.photo_thumb_url) { %>
                <span class="table-emoji"><img src="<%= item.photo_thumb_url %>" alt=""></span>
              <% } else { %>
                <span class="table-emoji"><%- include('../partials/icon', { name: 'utensils', size: 16 }) %></span>
              <% } %>
              <b><%= item.name_ru %></b>
              <span class="category"><%= item.category_name_ru %></span>
              <strong><%= Number(item.price).toLocaleString('ru-RU') %> <%= item.currency %></strong>
              <form class="inline" method="POST" action="/admin/items/<%= item.id %>/toggle">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="redirect" value="/admin">
                <button type="submit" class="btn <%= item.is_available ? 'btn-outline' : 'btn-danger' %>" style="font-size:10px; min-height:32px; padding:0 10px;">
                  <%= item.is_available ? t('items.available') : t('items.unavailable') %>
                </button>
              </form>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  </div>

  <script>
    (function () {
      var btn = document.getElementById('shareQrBtn');
      var note = document.getElementById('qrCopiedNote');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var url = window.location.origin + btn.dataset.url;
        if (navigator.share) {
          navigator.share({ title: document.title, url: url }).catch(function () {});
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () {
            note.style.display = 'inline-flex';
            setTimeout(function () { note.style.display = 'none'; }, 2000);
          });
        }
      });
    })();
  </script>
</body>
</html>
