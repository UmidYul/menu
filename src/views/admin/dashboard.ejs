<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= venue.name %> — панель управления</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f4f5f7; margin: 0; padding: 2rem; }
    header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    h1 { font-size: 1.25rem; margin: 0; }
    .role { color: #666; font-size: 0.85rem; }
    nav { margin-bottom: 1.5rem; }
    nav a { color: #1a73e8; text-decoration: none; margin-right: 1rem; font-size: 0.9rem; }
    button { padding: 0.5rem 1rem; background: #eee; border: 1px solid #ccc; border-radius: 6px; cursor: pointer; }
    .card { background: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); max-width: 480px; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1><%= venue.name %></h1>
      <div class="role">Вы вошли как <%= login %> (<%= role === 'venue_admin' ? 'администратор заведения' : 'сотрудник' %>)</div>
    </div>
    <form method="POST" action="/admin/logout">
      <button type="submit">Выйти</button>
    </form>
  </header>
  <% if (role === 'venue_admin') { %>
    <nav>
      <a href="/admin">Кабинет</a>
      <a href="/admin/categories">Категории</a>
    </nav>
  <% } %>
  <div class="card">
    <p><strong>Slug:</strong> <%= venue.slug %></p>
    <p><strong>Статус:</strong> <%= venue.is_active ? 'активно' : 'отключено' %></p>
  </div>
</body>
</html>
