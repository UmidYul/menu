<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= venue.name %> — <%= t('nav.dashboard') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { role, login, active: 'dashboard', venueSlug: venue.slug, lang, t }) %>
    <section class="admin-main">
      <%- include('../partials/admin-topbar', { crumb: venue.name, section: t('nav.dashboard'), lang, currentPath: '/admin', venueSlug: venue.slug, t }) %>
      <div class="admin-content">
        <div class="welcome">
          <div>
            <span class="eyebrow"><%= venue.name %></span>
            <h1><%= t('nav.dashboard') %></h1>
          </div>
          <% if (venue.status !== 'draft') { %>
            <a href="/menu/<%= venue.slug %>" target="_blank" rel="noopener" class="btn btn-primary">
              <%- include('../partials/icon', { name: 'externallink', size: 16 }) %>
              <%= t('nav.openMenu') %>
            </a>
          <% } %>
        </div>

        <% if (!venue.is_active) { %>
          <div class="alert alert-error"><%= t('dashboard.venueDisabledNotice') %></div>
        <% } else if (venue.status === 'grace') { %>
          <div class="alert alert-error">
            <%= t('dashboard.graceBanner', { days: graceDaysLeft }) %>
            <a href="/admin/subscription" class="link-arrow" style="margin-left:8px;"><%= t('dashboard.payButton') %> <%- include('../partials/icon', { name: 'arrowright', size: 13 }) %></a>
          </div>
        <% } else if (venue.status === 'suspended') { %>
          <div class="alert alert-error">
            <%= t('dashboard.suspendedBanner') %>
            <a href="/admin/subscription" class="link-arrow" style="margin-left:8px;"><%= t('dashboard.payButton') %> <%- include('../partials/icon', { name: 'arrowright', size: 13 }) %></a>
          </div>
        <% } else if (venue.status === 'archived') { %>
          <div class="alert alert-error">
            <%= t('dashboard.archivedBanner') %>
            <% if (siteSettings && siteSettings.telegram_url) { %>
              <a href="<%= siteSettings.telegram_url %>" target="_blank" rel="noopener" class="link-arrow" style="margin-left:8px;"><%= t('dashboard.contactSupportButton') %> <%- include('../partials/icon', { name: 'arrowright', size: 13 }) %></a>
            <% } %>
          </div>
        <% } else if (venue.status === 'trial' && daysLeft !== null) { %>
          <div class="alert alert-success"><%= t('dashboard.trialBanner', { days: daysLeft }) %></div>
        <% } %>

        <div class="checklist-card">
          <div class="checklist-header">
            <div>
              <span class="eyebrow"><%= t('dashboard.checklistEyebrow') %></span>
              <h3><%= t('dashboard.checklistHeading') %></h3>
            </div>
            <% if (checklistExpanded) { %>
              <form method="POST" action="/admin/checklist-collapse">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-outline checklist-toggle-btn"><%= t('dashboard.checklistCollapse') %></button>
              </form>
            <% } %>
          </div>

          <% if (checklistExpanded) { %>
            <div class="checklist-progress-row">
              <span class="checklist-progress-label"><%= t('dashboard.checklistProgress', { done: checklist.doneCount, total: checklist.total }) %></span>
            </div>
            <div class="checklist-progress-bar">
              <div class="checklist-progress-fill" style="transform: scaleX(<%= checklist.doneCount / checklist.total %>);"></div>
            </div>
            <ul class="checklist-items">
              <% checklist.items.forEach((item) => { %>
                <li class="checklist-item <%= item.done ? 'is-done' : '' %> <%= item.current ? 'is-current' : '' %>">
                  <span class="checklist-item-icon">
                    <%- include('../partials/icon', { name: item.done ? 'check' : item.icon, size: 16 }) %>
                  </span>
                  <span class="checklist-item-label"><%= t('dashboard.checklistItem_' + item.key) %></span>
                  <% if (item.current) { %>
                    <span class="checklist-item-action">
                      <% if (item.key === 'publish') { %>
                        <% if (venue.status === 'draft' && !publishReadiness.ready) { %>
                          <span class="checklist-item-hint">
                            <% if (publishReadiness.missing.includes('category')) { %><%= t('dashboard.publishMissingCategory') %><% } %>
                            <% if (publishReadiness.missing.includes('items')) { %><%= t('dashboard.publishMissingItems') %><% } %>
                            <% if (publishReadiness.missing.includes('all_demo')) { %><%= t('dashboard.publishMissingAllDemo') %><% } %>
                            <% if (publishReadiness.missing.includes('name')) { %><%= t('dashboard.publishMissingName') %><% } %>
                            <% if (publishReadiness.missing.includes('phone')) { %><%= t('dashboard.publishMissingPhone') %><% } %>
                          </span>
                        <% } else { %>
                          <form method="POST" action="/admin/publish">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn btn-primary btn-sm"><%= t('dashboard.checklistAction_publish') %></button>
                          </form>
                        <% } %>
                      <% } else if (item.key === 'qr') { %>
                        <a href="/admin/qr.png?download=1" download="menu-qr.png" class="btn btn-primary btn-sm">
                          <%= t('dashboard.checklistAction_qr') %>
                        </a>
                      <% } else if (item.key === 'preview') { %>
                        <a href="<%= item.href %>" target="_blank" rel="noopener" class="btn btn-primary btn-sm">
                          <%= t('dashboard.checklistAction_preview') %>
                        </a>
                      <% } else { %>
                        <a href="<%= item.href %>" class="btn btn-primary btn-sm">
                          <%= t('dashboard.checklistAction_' + item.key) %>
                        </a>
                      <% } %>
                    </span>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <form method="POST" action="/admin/checklist-expand">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="checklist-collapsed-bar">
                <span><%= t('dashboard.checklistProgress', { done: checklist.doneCount, total: checklist.total }) %></span>
                <span class="checklist-progress-bar">
                  <span class="checklist-progress-fill" style="transform: scaleX(<%= checklist.doneCount / checklist.total %>);"></span>
                </span>
              </button>
            </form>
          <% } %>
        </div>

        <div class="dashboard-grid">
          <div class="dashboard-card qr-card">
            <div class="card-header">
              <div>
                <span class="eyebrow"><%= t('dashboard.qrEyebrow') %></span>
                <h3><%= venue.name %></h3>
              </div>
            </div>
            <div class="qr-row">
              <img class="qr-image" src="/admin/qr.png" alt="QR" width="120" height="120">
              <div>
                <p><%= t('dashboard.qrScanHintLine1') %><br><%= t('dashboard.qrScanHintLine2') %></p>
                <button type="button" class="btn btn-outline" id="shareQrBtn" data-url="/menu/<%= venue.slug %>">
                  <%- include('../partials/icon', { name: 'share', size: 15 }) %>
                  <%= t('dashboard.shareButton') %>
                </button>
                <span id="qrCopiedNote" class="copied" style="display:none;"><%= t('dashboard.linkCopied') %></span>
              </div>
            </div>
          </div>

          <div class="dashboard-card">
            <div class="card-header">
              <div>
                <span class="eyebrow"><%= t('dashboard.viewsEyebrow') %></span>
                <h3><%= t('dashboard.viewsTitle') %></h3>
              </div>
              <%- include('../partials/icon', { name: 'barchart', size: 21 }) %>
            </div>
            <% if (stats.totalThisMonth === 0 && stats.trend === null) { %>
              <p class="empty-note" style="padding:24px 0;"><%= t('dashboard.noStatsYet') %></p>
            <% } else { %>
              <div class="metric">
                <%= stats.totalThisMonth %>
                <% if (stats.trend !== null) { %>
                  <span><%= stats.trend >= 0 ? '+' : '' %><%= stats.trend %>%</span>
                <% } %>
              </div>
              <div class="chart">
                <% stats.daily.forEach((day) => { %>
                  <i style="height: <%= day.heightPercent %>%;" title="<%= day.label %>: <%= day.count %>"></i>
                <% }) %>
              </div>
              <small>
                <% stats.daily.forEach((day) => { %><span><%= day.label %></span><% }) %>
              </small>
            <% } %>
          </div>
        </div>

        <div class="table-card">
          <div class="table-heading">
            <div>
              <span class="eyebrow"><%= t('dashboard.recentItemsEyebrow') %></span>
              <h3><%= t('dashboard.recentItemsTitle') %></h3>
            </div>
            <a href="/admin/items" class="btn btn-outline">
              <%= t('dashboard.viewAllItems') %>
              <%- include('../partials/icon', { name: 'arrowright', size: 15 }) %>
            </a>
          </div>
          <% if (recentItems.length === 0) { %>
            <div style="padding: 26px; color: var(--muted); font-size: 13px;"><%= t('dashboard.noItemsYet') %></div>
          <% } %>
          <% recentItems.forEach((item) => { %>
            <div class="table-row" style="grid-template-columns: 38px 1.5fr 1.1fr .8fr 100px;">
              <% if (item.photo_thumb_url) { %>
                <span class="table-emoji"><img src="<%= item.photo_thumb_url %>" alt=""></span>
              <% } else { %>
                <span class="table-emoji"><%- include('../partials/icon', { name: 'utensils', size: 16 }) %></span>
              <% } %>
              <b><%= pickLocalized(item, 'name', lang) %></b>
              <span class="category"><%= pickLocalized(item, 'category_name', lang) %></span>
              <strong><%= Number(item.price).toLocaleString('ru-RU') %> <%= item.currency %></strong>
              <form class="inline" method="POST" action="/admin/items/<%= item.id %>/toggle">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="redirect" value="/admin">
                <button type="submit" class="btn <%= item.is_available ? 'btn-outline' : 'btn-danger' %>" style="font-size:10px; min-height:32px; padding:0 10px;">
                  <%= item.is_available ? t('items.available') : t('items.unavailable') %>
                </button>
              </form>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  </div>

  <script>
    (function () {
      var btn = document.getElementById('shareQrBtn');
      var note = document.getElementById('qrCopiedNote');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var url = window.location.origin + btn.dataset.url;
        if (navigator.share) {
          navigator.share({ title: document.title, url: url }).catch(function () {});
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () {
            note.style.display = 'inline-flex';
            setTimeout(function () { note.style.display = 'none'; }, 2000);
          });
        }
      });
    })();
  </script>
</body>
</html>
