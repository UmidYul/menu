<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('staff.pageTitle') %></title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f4f5f7; margin: 0; padding: 2rem; }
    header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    nav { margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    nav a { color: #1a73e8; text-decoration: none; margin-right: 1rem; font-size: 0.9rem; }
    .lang-switch a { margin-right: 0.35rem; padding: 0.2rem 0.5rem; border-radius: 999px; background: #eee; color: #555; font-size: 0.75rem; }
    .lang-switch a.active { background: #1a1a1a; color: #fff; }
    h1 { font-size: 1.25rem; margin: 0; }
    h2 { font-size: 1.05rem; margin: 0 0 1rem; }
    .role { color: #666; font-size: 0.85rem; }
    button { padding: 0.5rem 1rem; background: #eee; border: 1px solid #ccc; border-radius: 6px; cursor: pointer; font-size: 0.9rem; }
    button.primary { background: #1a73e8; color: #fff; border-color: #1a73e8; }
    button.primary:hover { background: #1558b0; }
    button.danger { background: #fdecea; color: #b3261e; border-color: #f5c6c2; }
    table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 2rem; max-width: 560px; }
    th, td { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid #eee; }
    th { background: #fafafa; font-size: 0.85rem; color: #555; }
    .card { background: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); max-width: 400px; }
    label { display: block; font-size: 0.85rem; margin-bottom: 0.25rem; color: #333; }
    input { width: 100%; padding: 0.55rem; margin-bottom: 1rem; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; font-size: 0.95rem; }
    .error { background: #fdecea; color: #b3261e; padding: 0.6rem 0.8rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.9rem; max-width: 560px; }
    form.inline { display: inline; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1><%= t('staff.heading') %></h1>
      <div class="role"><%= t('common.loggedInAs') %> <%= login %> (<%= t('roles.venue_admin') %>)</div>
    </div>
    <form method="POST" action="/admin/logout">
      <button type="submit"><%= t('common.logout') %></button>
    </form>
  </header>
  <nav>
    <div>
      <a href="/admin"><%= t('nav.dashboard') %></a>
      <a href="/admin/categories"><%= t('nav.categories') %></a>
      <a href="/admin/items"><%= t('nav.items') %></a>
      <a href="/admin/venue-settings"><%= t('nav.venueSettings') %></a>
      <a href="/admin/staff"><%= t('nav.staff') %></a>
    </div>
    <div class="lang-switch">
      <a href="/admin/lang?lang=ru&redirect=/admin/staff" class="<%= lang === 'ru' ? 'active' : '' %>">RU</a>
      <a href="/admin/lang?lang=uz&redirect=/admin/staff" class="<%= lang === 'uz' ? 'active' : '' %>">UZ</a>
    </div>
  </nav>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <table>
    <thead>
      <tr>
        <th><%= t('staff.colLogin') %></th>
        <th><%= t('staff.colCreated') %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (staff.length === 0) { %>
        <tr><td colspan="3"><%= t('staff.empty') %></td></tr>
      <% } %>
      <% staff.forEach((s) => { %>
        <tr>
          <td><%= s.login %></td>
          <td><%= s.created_at.toISOString().slice(0, 10) %></td>
          <td>
            <form class="inline" method="POST" action="/admin/staff/<%= s.id %>?_method=DELETE"
                  onsubmit="return confirm('<%= t('staff.confirmDelete', { login: s.login }) %>');">
              <button type="submit" class="danger"><%= t('common.delete') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="card">
    <h2><%= t('staff.addHeading') %></h2>
    <form method="POST" action="/admin/staff">
      <label for="staff_login"><%= t('staff.loginLabel') %></label>
      <input type="text" id="staff_login" name="login" value="<%= formValues.login %>" required>

      <label for="staff_password"><%= t('staff.passwordLabel') %></label>
      <input type="password" id="staff_password" name="password" required minlength="6">

      <button type="submit" class="primary"><%= t('common.add') %></button>
    </form>
  </div>
</body>
</html>
