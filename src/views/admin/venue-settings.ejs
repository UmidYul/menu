<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('venueSettings.pageTitle') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { role, login, active: 'venueSettings', venueSlug, lang, t }) %>
    <section class="admin-main">
      <%- include('../partials/admin-topbar', { crumb: t('nav.dashboard'), section: t('venueSettings.heading'), lang, currentPath: '/admin/venue-settings', venueSlug, t }) %>
      <div class="admin-content">
        <div class="welcome">
          <div><span class="eyebrow"><%= t('nav.venueSettings') %></span><h1><%= t('venueSettings.heading') %></h1></div>
        </div>

        <% if (error) { %>
          <div class="alert alert-error" style="max-width:560px; margin-inline:auto;"><%= error %></div>
        <% } %>
        <% if (saved) { %>
          <div class="alert alert-success" style="max-width:560px; margin-inline:auto;"><%= t('venueSettings.saved') %></div>
        <% } %>

        <div class="form-card" style="max-width:560px; margin-inline:auto;">
          <form method="POST" action="/admin/venue-settings">
            <div class="field">
              <label for="phone"><%= t('venueSettings.phoneLabel') %></label>
              <input type="text" id="phone" name="phone" value="<%= formValues.phone %>" placeholder="<%= t('venueSettings.phonePlaceholder') %>">
            </div>

            <div class="field">
              <label for="address"><%= t('venueSettings.addressLabel') %></label>
              <input type="text" id="address" name="address" value="<%= formValues.address %>">
            </div>

            <div class="field">
              <label for="address_2gis_url"><%= t('venueSettings.address2gisLabel') %></label>
              <input type="text" id="address_2gis_url" name="address_2gis_url" value="<%= formValues.address_2gis_url %>" placeholder="https://2gis.uz/...">
            </div>

            <div class="field-grid">
              <div class="field">
                <label for="latitude"><%= t('venueSettings.latitudeLabel') %></label>
                <input type="text" id="latitude" name="latitude" value="<%= formValues.latitude %>" placeholder="41.311081">
              </div>
              <div class="field">
                <label for="longitude"><%= t('venueSettings.longitudeLabel') %></label>
                <input type="text" id="longitude" name="longitude" value="<%= formValues.longitude %>" placeholder="69.240562">
              </div>
            </div>
            <p class="hint" style="margin:-10px 0 18px;"><%= t('venueSettings.coordinatesHint') %></p>

            <div class="field-grid">
              <div class="field">
                <label for="instagram_url"><%= t('venueSettings.instagramLabel') %></label>
                <input type="text" id="instagram_url" name="instagram_url" value="<%= formValues.instagram_url %>" placeholder="https://instagram.com/...">
              </div>
              <div class="field">
                <label for="telegram_url"><%= t('venueSettings.telegramLabel') %></label>
                <input type="text" id="telegram_url" name="telegram_url" value="<%= formValues.telegram_url %>" placeholder="https://t.me/...">
              </div>
            </div>

            <h3 style="font-family: var(--font-serif); font-size: 18px; font-weight: 500; margin: 26px 0 6px;"><%= t('venueSettings.wifiLabel') %></h3>
            <p class="hint" style="margin: 0 0 16px;"><%= t('venueSettings.wifiHint') %></p>
            <div class="field-grid">
              <div class="field">
                <label for="wifi_ssid"><%= t('venueSettings.wifiSsidLabel') %></label>
                <input type="text" id="wifi_ssid" name="wifi_ssid" value="<%= formValues.wifi_ssid %>">
              </div>
              <div class="field">
                <label for="wifi_password"><%= t('venueSettings.wifiPasswordLabel') %></label>
                <input type="text" id="wifi_password" name="wifi_password" value="<%= formValues.wifi_password %>">
              </div>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:14px;"><%= t('venueSettings.submit') %></button>
          </form>
        </div>
      </div>
    </section>
  </div>
</body>
</html>
