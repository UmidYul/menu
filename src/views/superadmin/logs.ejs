<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('superadmin.logsHeading') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { role, login, active: 'logs', lang, t }) %>
    <section class="admin-main">
      <%- include('../partials/admin-topbar', { crumb: t('roles.superadmin'), section: t('superadmin.logsHeading'), lang, currentPath: '/superadmin/logs', t }) %>
      <div class="admin-content">
        <div class="welcome">
          <div><span class="eyebrow"><%= t('roles.superadmin') %></span><h1><%= t('superadmin.logsHeading') %></h1></div>
        </div>

        <form method="GET" action="/superadmin/logs" class="field-grid" style="max-width:560px; margin-bottom:20px;">
          <div class="field" style="margin-bottom:0;">
            <select name="venue_id" onchange="this.form.submit()">
              <option value=""><%= t('superadmin.logsFilterAllVenues') %></option>
              <% venues.forEach((venue) => { %>
                <option value="<%= venue.id %>" <%= String(filterVenueId) === String(venue.id) ? 'selected' : '' %>><%= venue.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="field" style="margin-bottom:0;">
            <select name="action_type" onchange="this.form.submit()">
              <option value=""><%= t('superadmin.logsFilterAllActions') %></option>
              <% actionTypeOptions.forEach((option) => { %>
                <option value="<%= option.value %>" <%= filterActionType === option.value ? 'selected' : '' %>><%= option.label %></option>
              <% }) %>
            </select>
          </div>
        </form>

        <div class="table-card">
          <% if (logs.rows.length === 0) { %>
            <div style="padding: 26px; color: var(--muted); font-size: 13px;"><%= t('superadmin.logsEmpty') %></div>
          <% } %>
          <% logs.rows.forEach((row) => { %>
            <div class="table-row" style="grid-template-columns: 130px 110px 1fr 1fr 1.4fr;">
              <span class="category"><%= row.created_at.toISOString().slice(0, 16).replace('T', ' ') %></span>
              <b style="font-weight:600;"><%= row.admin_login %></b>
              <span class="category"><%= row.venue_name || '—' %></span>
              <span><%= row.actionLabel %></span>
              <span class="category" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= row.details ? JSON.stringify(row.details) : '' %>">
                <%= row.entityLabel %> #<%= row.entity_id %>
                <% if (row.details) { %> — <%= JSON.stringify(row.details).slice(0, 60) %><% } %>
              </span>
            </div>
          <% }) %>
        </div>

        <% if (logs.totalPages > 1) { %>
          <div style="display:flex; align-items:center; justify-content:center; gap:14px; margin-top:20px; font-size:12px; color:var(--muted);">
            <% if (logs.page > 1) { %>
              <a href="/superadmin/logs?venue_id=<%= filterVenueId %>&action_type=<%= filterActionType %>&page=<%= logs.page - 1 %>" class="btn btn-outline"><%= t('superadmin.pagePrev') %></a>
            <% } %>
            <span><%= t('superadmin.pageInfo', { page: logs.page, totalPages: logs.totalPages }) %></span>
            <% if (logs.page < logs.totalPages) { %>
              <a href="/superadmin/logs?venue_id=<%= filterVenueId %>&action_type=<%= filterActionType %>&page=<%= logs.page + 1 %>" class="btn btn-outline"><%= t('superadmin.pageNext') %></a>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </div>
</body>
</html>
