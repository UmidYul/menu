<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('superadmin.leadsHeading') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
<%
  const STATUS_BADGE_CLASS = { new: 'status warn', contacted: 'status warn', approved: 'status', rejected: 'status off', spam: 'status off' };
%>
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { role, login, active: 'leads', lang, t }) %>
    <section class="admin-main">
      <%- include('../partials/admin-topbar', { crumb: t('roles.superadmin'), section: t('superadmin.leadsHeading'), lang, currentPath: '/superadmin/leads', t }) %>
      <div class="admin-content">
        <div class="welcome">
          <div><span class="eyebrow"><%= t('roles.superadmin') %></span><h1><%= t('superadmin.leadsHeading') %></h1></div>
        </div>

        <form method="GET" action="/superadmin/leads" class="field-grid" style="max-width:560px; margin-bottom:20px;">
          <div class="field" style="margin-bottom:0;">
            <select name="status" onchange="this.form.submit()">
              <option value=""><%= t('superadmin.leadsFilterAllStatuses') %></option>
              <% ['new', 'contacted', 'approved', 'rejected', 'spam'].forEach((s) => { %>
                <option value="<%= s %>" <%= filterStatus === s ? 'selected' : '' %>><%= t(`superadmin.leadStatus.${s}`) %></option>
              <% }) %>
            </select>
          </div>
          <div class="field" style="margin-bottom:0; display:flex; gap:8px;">
            <input type="text" name="search" value="<%= filterSearch %>" placeholder="<%= t('superadmin.leadsSearchPlaceholder') %>" style="flex:1;">
            <button type="submit" class="btn btn-outline" style="flex-shrink:0;"><%- include('../partials/icon', { name: 'search', size: 15 }) %></button>
          </div>
        </form>

        <div class="table-card">
          <% if (leads.rows.length === 0) { %>
            <div style="padding: 26px; color: var(--muted); font-size: 13px;"><%= t('superadmin.leadsEmpty') %></div>
          <% } %>
          <% leads.rows.forEach((lead) => { %>
            <div class="table-row" style="grid-template-columns: 110px 1fr 1fr .8fr .8fr .8fr 90px;">
              <span class="category"><%= lead.created_at.toISOString().slice(0, 10) %></span>
              <a href="/superadmin/leads/<%= lead.id %>"><b><%= lead.venue_name %></b></a>
              <span><%= lead.contact_name %> · <%= lead.phone %></span>
              <span class="category"><%= lead.venue_type ? t(`bot.apply.venueType.${lead.venue_type}`) : '—' %></span>
              <span class="category"><%= t(`bot.lead.source.${lead.source}`) %></span>
              <span class="<%= STATUS_BADGE_CLASS[lead.status] %>"><i></i> <%= t(`superadmin.leadStatus.${lead.status}`) %></span>
              <a href="/superadmin/leads/<%= lead.id %>" class="btn btn-outline" style="font-size:10px; min-height:32px; padding:0 10px;"><%= t('superadmin.detailAction') %></a>
            </div>
          <% }) %>
        </div>

        <% if (leads.totalPages > 1) { %>
          <div style="display:flex; align-items:center; justify-content:center; gap:14px; margin-top:20px; font-size:12px; color:var(--muted);">
            <% if (leads.page > 1) { %>
              <a href="/superadmin/leads?status=<%= filterStatus %>&search=<%= encodeURIComponent(filterSearch) %>&page=<%= leads.page - 1 %>" class="btn btn-outline"><%= t('superadmin.pagePrev') %></a>
            <% } %>
            <span><%= t('superadmin.pageInfo', { page: leads.page, totalPages: leads.totalPages }) %></span>
            <% if (leads.page < leads.totalPages) { %>
              <a href="/superadmin/leads?status=<%= filterStatus %>&search=<%= encodeURIComponent(filterSearch) %>&page=<%= leads.page + 1 %>" class="btn btn-outline"><%= t('superadmin.pageNext') %></a>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </div>
</body>
</html>
