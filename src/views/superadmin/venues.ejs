<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('superadmin.pageTitle') %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
<%
  const activeCount = venues.filter((v) => v.is_active).length;
%>
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { role, login, active: 'venues', lang, t }) %>
    <section class="admin-main">
      <%- include('../partials/admin-topbar', { crumb: t('roles.superadmin'), section: t('superadmin.heading'), lang, currentPath: '/superadmin/venues', t }) %>
      <div class="admin-content">
        <div class="welcome">
          <div><span class="eyebrow"><%= t('roles.superadmin') %></span><h1><%= t('superadmin.heading') %></h1></div>
        </div>

        <div class="super-stats">
          <div><span><%= t('superadmin.statTotal') %></span><b><%= venues.length %></b></div>
          <div><span><%= t('superadmin.statusActive') %></span><b><%= activeCount %></b></div>
          <div><span><%= t('superadmin.statusInactive') %></span><b><%= venues.length - activeCount %></b></div>
        </div>

        <div class="table-card">
          <div class="table-heading">
            <div><span class="eyebrow">&nbsp;</span><h3><%= t('superadmin.heading') %></h3></div>
            <button type="button" class="btn btn-primary" onclick="document.getElementById('add-venue-modal').showModal()">
              <%- include('../partials/icon', { name: 'plus', size: 15 }) %> <%= t('common.add') %>
            </button>
          </div>
          <% if (venues.length === 0) { %>
            <div style="padding: 26px; color: var(--muted); font-size: 13px;"><%= t('superadmin.empty') %></div>
          <% } %>
          <% venues.forEach((venue) => { %>
            <div class="venue-row" style="grid-template-columns: 35px .95fr .7fr .8fr .75fr .8fr 90px 90px 90px;">
              <span class="venue-mini"><%= venue.name.charAt(0).toUpperCase() %></span>
              <a href="/superadmin/venues/<%= venue.id %>"><b><%= venue.name %></b></a>
              <span><%= venue.slug %></span>
              <span><%= venue.subscription_until || t('superadmin.subscriptionNone') %></span>
              <span class="<%= venue.is_active ? 'status' : 'status off' %>"><i></i> <%= venue.is_active ? t('superadmin.statusActive') : t('superadmin.statusInactive') %></span>
              <span><%= venue.show_powered_by ? t('superadmin.poweredByShown') : t('superadmin.poweredByHidden') %></span>
              <form class="inline" method="POST" action="/superadmin/venues/<%= venue.id %>/toggle-active">
                <button type="submit" class="btn btn-outline" style="font-size:10px; min-height:32px; padding:0 10px;"><%= venue.is_active ? t('superadmin.disable') : t('superadmin.enable') %></button>
              </form>
              <form class="inline" method="POST" action="/superadmin/venues/<%= venue.id %>/toggle-powered-by">
                <button type="submit" class="btn btn-outline" style="font-size:10px; min-height:32px; padding:0 10px;"><%= venue.show_powered_by ? t('superadmin.hidePoweredBy') : t('superadmin.showPoweredByAction') %></button>
              </form>
              <a href="/superadmin/venues/<%= venue.id %>" class="btn btn-outline" style="font-size:10px; min-height:32px; padding:0 10px;"><%= t('superadmin.detailAction') %></a>
            </div>
          <% }) %>
        </div>

        <dialog id="add-venue-modal" class="modal">
          <div class="modal-head">
            <h3><%= t('superadmin.addHeading') %></h3>
            <button type="button" class="modal-close" onclick="this.closest('dialog').close()">
              <%- include('../partials/icon', { name: 'x', size: 18 }) %>
            </button>
          </div>
          <div class="modal-body">
            <% if (error) { %>
              <div class="alert alert-error"><%= error %></div>
            <% } %>
            <form method="POST" action="/superadmin/venues">
              <div class="field">
                <label for="slug"><%= t('superadmin.slugLabel') %></label>
                <input type="text" id="slug" name="slug" value="<%= formValues.slug %>" placeholder="my-cafe" required>
                <div class="hint"><%= t('superadmin.slugHint') %></div>
              </div>

              <div class="field">
                <label for="name"><%= t('superadmin.nameLabel') %></label>
                <input type="text" id="name" name="name" value="<%= formValues.name %>" required>
              </div>

              <div class="field">
                <label for="lang_default"><%= t('superadmin.langDefaultLabel') %></label>
                <select id="lang_default" name="lang_default">
                  <option value="ru" <%= formValues.lang_default === 'ru' ? 'selected' : '' %>>Русский</option>
                  <option value="uz" <%= formValues.lang_default === 'uz' ? 'selected' : '' %>>Oʻzbekcha</option>
                </select>
              </div>

              <div class="field">
                <label for="admin_login"><%= t('superadmin.adminLoginLabel') %></label>
                <input type="text" id="admin_login" name="admin_login" value="<%= formValues.admin_login %>" required>
              </div>

              <div class="field">
                <label for="admin_password"><%= t('superadmin.adminPasswordLabel') %></label>
                <input type="password" id="admin_password" name="admin_password" required minlength="6">
              </div>

              <button type="submit" class="btn btn-primary" style="width:100%;"><%- include('../partials/icon', { name: 'plus', size: 15 }) %> <%= t('superadmin.submit') %></button>
            </form>
          </div>
        </dialog>
        <% if (formTarget === 'add' && error) { %>
          <script>document.getElementById('add-venue-modal').showModal();</script>
        <% } %>
      </div>
    </section>
  </div>
</body>
</html>
