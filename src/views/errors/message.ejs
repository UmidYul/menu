<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <%- include('../partials/head-assets') %>
</head>
<body>
  <div class="message-shell">
    <div class="message-card">
      <div class="brand" style="justify-content:center; margin-bottom:24px;"><%- include('../partials/brand', { compact: true }) %></div>
      <h1><%= title %></h1>
      <p><%= message %></p>
      <a href="<%= backUrl || '/admin/login' %>" class="btn btn-outline"><%= t('errors.back') %></a>
    </div>
  </div>
</body>
</html>
