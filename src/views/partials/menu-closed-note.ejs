<%
// Промт 2.3, edge case: гость зашёл, когда всё меню вне расписания. Пустую страницу показывать
// нельзя — говорим, когда откроемся; контакты у гостя остаются в футере и в карточке заведения.
// Партиал, а не кусок menu.ejs, потому что нужен в двух местах: когда скрыто вообще всё
// (режим hide — секций на странице не остаётся) и когда позиции показаны приглушёнными
// (режим dim — сообщение идёт над списком).
// Ожидает: nextOpeningTime (строка 'ЧЧ:ММ' или null), t.
%>
<div class="menu-closed-note">
  <%- include('./icon', { name: 'clock', size: 18 }) %>
  <p>
    <b><%= t('schedules.menuClosedHeading') %></b>
    <% if (nextOpeningTime) { %>
      <span><%= t('schedules.menuClosedOpensAt', { time: nextOpeningTime }) %></span>
    <% } %>
  </p>
</div>
