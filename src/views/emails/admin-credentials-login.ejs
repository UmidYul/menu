<%
// payload: { venue_name, admin_login, login_url }, t, siteSettings, escapeHtml
// Первое из двух писем (промт 1.5, п.1) — только логин и ссылка на вход, пароль уходит
// отдельным письмом (admin-credentials-password.ejs). venue_name/admin_login — пользовательский
// ввод, экранируем перед вставкой в bodyHtml.
const bodyHtml = `
  <p>${escapeHtml(t('bot.templates.adminCredentialsLoginLine1', { venueName: payload.venue_name }))}</p>
  <p>${escapeHtml(t('bot.templates.adminCredentialsLoginLine2', { login: payload.admin_login }))}</p>
  <p><a href="${escapeHtml(payload.login_url)}" style="color:#c65d42;">${escapeHtml(payload.login_url)}</a></p>
  <p>${escapeHtml(t('bot.templates.adminCredentialsLoginLine3'))}</p>
`;
%>
<%- include('./layout', { title: t('bot.templates.adminCredentialsLoginSubject', { venueName: payload.venue_name }), bodyHtml, siteSettings }) %>
