# Обязательные — без них приложение не стартует.
DATABASE_URL=postgres://qrmenu:qrmenu@localhost:5433/qrmenu
SESSION_SECRET=change-me-to-a-random-secret

PORT=3000
NODE_ENV=development

# Публичный адрес сервиса — используется в ссылках внутри писем и в сообщениях бота (там нет
# req, чтобы собрать адрес из заголовков запроса). В dev, если не задан, берётся localhost:PORT.
APP_BASE_URL=http://localhost:3000

# Почта (SMTP) — опционально. Без неё сервер стартует, но письма (восстановление пароля,
# уведомления) не отправляются: mailer.send() логирует предупреждение и ничего не делает.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=qr.menu

# Токен Telegram-бота сервиса — опционально, без него функции, связанные с ботом, отключены.
# Процесс бота (npm run bot) с незаданным BOT_TOKEN не стартует вообще — веб-приложение
# при этом продолжает работать, уведомления просто копятся в очереди со статусом pending.
BOT_TOKEN=

# Username бота без @ (например qrmenu_uz_bot) — отдельно от токена: нужен веб-процессу, чтобы
# собрать ссылку-приглашение t.me/<username>?start=... на странице привязки Telegram
# (/admin/password). Веб-процесс не имеет своего соединения с Bot API и не может узнать
# username сам.
BOT_USERNAME=

# 'polling' — для локальной разработки, ничего дополнительно поднимать не нужно.
# 'webhook' — для продакшена, тогда обязательны и BOT_WEBHOOK_URL, и BOT_WEBHOOK_SECRET.
BOT_MODE=polling
BOT_PORT=3001
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# Telegram ID владельца сервиса — получает алерты, видит /stats и /pending в боте.
# Несколько через запятую: 123456,789012
OWNER_TELEGRAM_ID=

# --- Мониторинг и логи (промт 4.2) -----------------------------------------------------------
# Каталог структурированных логов с ротацией. По умолчанию ./logs рядом с проектом.
LOG_DIR=

# Токен подробного health-check. Без него /health/detailed доступен ТОЛЬКО с localhost —
# наружу сведения о диске, памяти и очередях без пароля отдавать нельзя. Задайте длинную
# случайную строку, если монитор ходит с другой машины.
HEALTH_TOKEN=

# Путь к файлу состояния бэкапов — его пишет scripts/backup.sh (промт 4.1). Не задан —
# /health/detailed честно сообщает «бэкапы не настроены», а не рисует зелёный статус.
#
# ДОЛЖЕН совпадать с BACKUP_STATE_FILE в scripts/backup.env, иначе health-check будет
# сообщать «бэкапы не настроены» ровно в то время, когда они исправно идут.
# Остальная конфигурация бэкапов живёт в scripts/backup.env: её читают скрипты, запускаемые
# от root по таймеру, и приложению она не нужна.
BACKUP_STATE_FILE=

# --- Диагностика запросов (промт 3.6) ---------------------------------------------------------
# QUERY_AUDIT=1 включает предупреждения в консоль о запросах к таблицам заведения без фильтра
# по нему (см. src/config/queryAudit.js). Это подсказка разработчику при разборе новой модели,
# а не защита: ложные срабатывания там ожидаемы, и в production переменная игнорируется.
# Пустое значение или отсутствие переменной — аудит выключен, накладных расходов нет.
QUERY_AUDIT=

# --- Свои домены заведений (промт 3.7) --------------------------------------------------------
# Собственный хост сервиса — ОПОРА всей маршрутизации по хосту: «Host не совпал с ним» и означает
# «это домен заведения». Не задан — выводится из APP_BASE_URL; не задано и оно — свои домены
# выключены целиком (отличить свой хост от чужого нечем, и угадывать опаснее, чем не работать).
# Без порта и без протокола: qr.menu
SERVICE_HOST=

# Что владелец заведения прописывает у регистратора, чтобы направить домен к нам.
# CNAME предпочтительнее A-записи: при переезде сервера заведениям не придётся менять DNS.
# Не задан — берётся SERVICE_HOST.
CUSTOM_DOMAIN_CNAME_TARGET=

# IPv4 сервера — для A-записи в зонах, где CNAME на нужном уровне не поддерживается.
# Не задан — в инструкции показывается только вариант с CNAME, и это рабочий сценарий.
SERVER_IPV4=

# Каталог, из которого nginx отдаёт /.well-known/acme-challenge/ для ВСЕХ кастомных доменов
# сразу (см. раздел про nginx в README). Читается только скриптами scripts/issue-cert.sh
# и scripts/renew-certs.sh, самому приложению не нужен.
ACME_WEBROOT=/var/www/acme

# Почта для Let's Encrypt — на неё приходят предупреждения об истекающих сертификатах.
# Тоже только для скриптов выпуска.
CERTBOT_EMAIL=
